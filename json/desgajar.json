{
  "lema": "DESGAJAR.",
  "categoria_gramatical": "v.",
  "introduccion": "",
  "acepciones": [
    {
      "id": "a)",
      "definicion": "Dejar el tronco sin una ó más ramas desgarrándolas ó arrancándolas con violencia (trans.).",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Las puertas le desquiciaban | De noche, y por ir á hurtar | La fruta, le desgajaban | El pobre árbol.»",
              "autor": "Tirso",
              "referencia_obra": ", El pretendiente al revés, 1. 8 (R. 5. 252)."
            },
            {
              "marca": "",
              "texto_cita": "«Esta empresa lo representa en el árbol coronado que significa el reino, de quien si tiraren dos manos, aunque sean animadas de una misma sangre, le desgajarán, y quedará rota y inútil la corona. Saav. Emp. 70 (R. 5. 1941).",
              "autor": "",
              "referencia_obra": ""
            },
            {
              "marca": "",
              "texto_cita": "«Redil y chozas por delante lleva, | Y la encina firmísima desgaja.»",
              "autor": "Lista",
              "referencia_obra": ", Poes. filosóf. 10 (R. 67. 3072)."
            },
            {
              "marca": "",
              "texto_cita": "«Desgaja el roble y la robusta encina.»",
              "autor": "",
              "referencia_obra": "Id. Idil. 4 (R. 67. 3541)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Part.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Encendió una gruesa tea de un desolajado pino.»",
                  "autor": "Lope",
                  "referencia_obra": ", Arcadia, 2 (Obr. suelt. 118)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        }
      ]
    },
    {
      "id": "b)",
      "definicion": "Desgarrar ó arrancar con violencia la rama del tronco (trans.).",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«El aire las cargadas ramas mueve, | Que el peso de la nieve las desgaja.»",
              "autor": "",
              "referencia_obra": "Garcil, égl. 2 (R. 32. 172)."
            },
            {
              "marca": "",
              "texto_cita": "«Aguijan á las armas, desgajando | Las ramas al depósito obligadas.»",
              "autor": "Erc.",
              "referencia_obra": "Arauc. 2 (R. 17. 82)."
            },
            {
              "marca": "",
              "texto_cita": "«Como en Olimpo y Osa el tracio viento --- | Desgaja el duro ramo, cimbra el tronco ---»",
              "autor": "Jáur.",
              "referencia_obra": "Fars. 2 (Fern. 7. 35)."
            },
            {
              "marca": "",
              "texto_cita": "«Desgajan unos la rama | De que estaba suspendido.»",
              "autor": "M. de la Rosa",
              "referencia_obra": ", Poes. El castigo del amor (1. 29)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Pas.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Es evidente el desgajarse la rama con el peso.»",
                  "autor": "Césp. y Men.",
                  "referencia_obra": "Sold. Pínd. 1. 6 (R. 18. 2861)."
                }
              ],
              "subsubsubacepciones": []
            },
            {
              "id_marcador_html": "— β β )",
              "id_limpio": "— β β )",
              "definicion": "Part.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«A puñados la fruta unos comían --- | Quién huye al repartir la compañía, | Buscando en lo escondido parte alguna | Donde comer la rama desgajada, | De las rapaces manos escapada.»",
                  "autor": "Erc.",
                  "referencia_obra": "Arauc. 36 (R. 17. 1311)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        },
        {
          "id_marcador_html": "— β )",
          "id_limpio": "— β )",
          "definicion": "Con de, en el sentido de separación.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«De la primera encina ó roble que se me depare, pienso desgajar otro tronco tal y tan bueno como aquél.»",
              "autor": "Cerv.",
              "referencia_obra": "Quij. 1. 8 (R. 1. 2692)."
            },
            {
              "marca": "",
              "texto_cita": "«Desgajó de una encina un pesado ramo ó tronco.»",
              "autor": "",
              "referencia_obra": "Id. ib. 1. 8 (R. 1. 2692)."
            },
            {
              "marca": "",
              "texto_cita": "«Aquella noche la pasaron entre unos árboles, y del uno dellos desgajó D. Quijote un ramo seco que casi le podía servir de lanza.»",
              "autor": "",
              "referencia_obra": "Id. ib. 1. 8 (R. 1. 2701)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        }
      ]
    },
    {
      "id": "c)",
      "definicion": "met. Separar con violencia una cosa de aquella con que está trabada ó de que forma parte (trans.).",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Con violencia desgajó infinita [el jayán] | La mayor parte de la excelsa roca.»",
              "autor": "Góng.",
              "referencia_obra": "Polif. (R. 32. 4631)."
            },
            {
              "marca": "",
              "texto_cita": "«Arrojó tantas piedars desde arriba, | Que las velas dejó como una criba. | Con los terribles ímpetus desgaja | Los anchurosos lienzos de las naves.»",
              "autor": "Villav.",
              "referencia_obra": "Mosq. 5 (R. 17. 5911)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Refl.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Mi rocín, viéndose en aprieto, se esforzó á tirar dos coces, y de puro flaco, se le desgajaron las ancas, y quedó en el lodo, bien cerca de acabar.»",
                  "autor": "Quev.",
                  "referencia_obra": "Gran Tac. 2 (R. 23. 4882)."
                },
                {
                  "marca": "",
                  "texto_cita": "«Detener de Fortuna la rodaja | A pocos concedió poder divino; | Y si la cumbre desvanece el tino, | También tal vez la cumbre se desgaja.»",
                  "autor": "",
                  "referencia_obra": "Id. Musa, 2, son. 16 (R. 69.162)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        },
        {
          "id_marcador_html": "— β )",
          "id_limpio": "— β )",
          "definicion": "Con de, en el sentido de separación.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Tomó al parecer este nombre [el Peñón de Vélez de la Gomera] por hallarse tan cercano á dicha ciudad, como que solo le dividía de ella un estrecho brazo de mar. que parece haber desgajado aquel peñasco de los vecinos montes.»",
              "autor": "M. de la Rosa",
              "referencia_obra": ", Is. de Solís, 1. 25 (4. 274)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Refl.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Así tal vez del Alpe se desgaja | Peñasco altivo en ímpetu furioso.»",
                  "autor": "Valb.",
                  "referencia_obra": "Bern. 1 (R. 17. 1501)."
                }
              ],
              "subsubsubacepciones": []
            },
            {
              "id_marcador_html": "— β β )",
              "id_limpio": "— β β )",
              "definicion": "Part.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«¿Quién [podrá] un peñasco suspender valiente | De la cima de un monte desgajado?»",
                  "autor": "Cald.",
                  "referencia_obra": "La vida es sueño, 3. 5 (R. 7. 142)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        },
        {
          "id_marcador_html": "— γ )",
          "id_limpio": "— γ )",
          "definicion": "Refl.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Desgajarse la ropa es romperse.»",
              "autor": "Covarr.",
              "referencia_obra": "(ant.)"
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        }
