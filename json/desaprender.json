          "ejemplos_citas": [
            {
              "texto_cita": "«¿Por qué lo niegas? — Porque   deprendí á decir verdades. — No hace cosa justa el que desaprende lo que   aprendió.»",
              "autor": "<a name=\"autor273\"><font color = \"#FF000\"><u>Villalobos</u></font></b>",
              "author": "<a name=\"autor273\"><font color = \"#FF000\"><u>Villalobos</u></font></b>",
              "referencia_obra": ", <i>Anfitrión </i>(R. 36. 473<sup>1</sup>).   </font><font face=\"arial\" color=\"#000080\">"
            },
            {
              "texto_cita": "«El que aprende mala doctrina tendrá dos   trabajos en vano, uno en aprender mal y otro en desaprender lo aprendido.»",
              "autor": "",
              "author": "",
              "referencia_obra": "</font><font   face=\"arial\"> Pinciano, <i>Filosof. epist.</i> 3,<i> fragm. </i>1 (<i>Dicc. Autor.</i>).   </font><font face=\"arial\" color=\"#000080\">"
            },
            {
              "texto_cita": "«Lo más y primero que me enseñaron fue á   desaprender el mal que sabía.»",
              "autor": "<a name=\"autor274\"><font color = \"#FF000\"><u>Quev.</u></font></b>",
              "author": "<a name=\"autor274\"><font color = \"#FF000\"><u>Quev.</u></font></b>",
              "referencia_obra": "<i>Job </i>(R. 48. 228<sup>2</sup>)."
            }
          ],
          "subsubacepciones": []
        },
