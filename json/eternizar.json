{
  "lema": "ETERNIZAR. *",
  "categoria_gramatical": "v.",
  "introduccion": "",
  "acepciones": [
    {
      "id": "a)",
      "definicion": "Perpetuar, hacer eterna o muy duradera una cosa (trans.).",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "X",
              "texto_cita": "«Lloren tu muerte Henares, Tajo, Tormes; | Que el patrio Manzanares, que eternizas, | Lágrimas mestas librará conformes.»",
              "autor": "Lope",
              "referencia_obra": ", Gatom. (ed. Rdgz. Marín, p. 91)."
            },
            {
              "marca": "X",
              "texto_cita": "«Huélgome al fin, | Que éstos que el mundo eterniza | Buscan a Horacio en latín, | Y está en la caballeriza.»",
              "autor": "",
              "referencia_obra": "Id. Los melindres de Belisa, p. 117."
            },
            {
              "marca": "X",
              "texto_cita": "«Pero los Godos, llamados assí por aver salido de la Gothia, fueron los que con su valor y esfuerço eternizaron su nombre.»",
              "autor": "Berg.",
              "referencia_obra": "Antigüed. 1. 1. 1 (p. 13)."
            },
            {
              "marca": "X",
              "texto_cita": "«Amor fue vuestra culpa; vuestra gloria | Eternizar del padre la memoria.»",
              "autor": "Caro",
              "referencia_obra": ", Obras de Virgilio (2. 405)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Con dat. de persona.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Ya el hijo de Japeto | Con temerario intento | Robó a Tonante por engaño el fuego, | Y eternizó su nombre.»",
                  "autor": "Arguijo",
                  "referencia_obra": ", Obra poética (Cl. Castal. 40. 249)."
                },
                {
                  "marca": "X",
                  "texto_cita": "«Cisnes de Guadiana, a sus riberas, | Llegué --- | No a escuchar vuestras vozes lisongeras, sino al segundo illustrador del día | Consagralle la humilde Musa mía, | Que cantó burlas y eterniza veras | Al Apolo de España, al de Aiamonte | Culto honor.»",
                  "autor": "Góng.",
                  "referencia_obra": "Obras poéticas (ed. Foulché-Delbosc, 1. 281)."
                }
              ],
              "subsubsubacepciones": []
            },
            {
              "id_marcador_html": "— β β )",
              "id_limpio": "— β β )",
              "definicion": "Con en.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Sólo su nombre eterniza | En Dios el que a mucha costa | Corre por la senda angosta, | Huyendo el despeñadero.»",
                  "autor": "Solís",
                  "referencia_obra": "y Valenzuela, El desierto prodigioso (ICC. 45. 71)."
                },
                {
                  "marca": "X",
                  "texto_cita": "«Así en tus gentes eternice el hado | Un recuerdo legal de tus proezas.»",
                  "autor": "Lobo",
                  "referencia_obra": ", Obr. poética, 2 (p. 180)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        },
        {
          "id_marcador_html": "— β )",
          "id_limpio": "— β )",
          "definicion": "Refl.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "X",
              "texto_cita": "«Acuden todos a colmar sus vasos | Al océano sacro de Stagira | Donde se afirman los dudosos pasos, | Se eterniza la trompa y tierna lira.»",
              "autor": "Cueva",
              "referencia_obra": ", Ejemplar poético (Cl. C. 60. 148)."
            },
            {
              "marca": "X",
              "texto_cita": "«Hacia el mes de agosto, cuando el invierno empezaba a eternizarse, Úrsula pudo por fin darle una noticia que parecía verdad.»",
              "autor": "Márquez",
              "referencia_obra": ", Cien años de soledad (ed. 1977, p. 102)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Con en.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Dos en una carne son. | — Dura mil años la unión, | Y en esta paz se eternicen.»",
                  "autor": "Lope",
                  "referencia_obra": ", El nacimiento de Cristo (R. 158. 227)."
                },
                {
                  "marca": "X",
                  "texto_cita": "«La renovación da perpetuidad a las cosas caducas por naturaleza: unos individuos se van eternizando en otros, conservadas assí las especies.»",
                  "autor": "Saav.",
                  "referencia_obra": "Emp. 66 (Dicc. Autor.)."
                },
                {
                  "marca": "X",
                  "texto_cita": "«¡Oh qué arriesgada es la dicha, | Que se funda en el arbitrio, | De que en tanto entendimiento | Se eternice un desvarío!»",
                  "autor": "Lobo",
                  "referencia_obra": ", Obr. poética, 1 (p. 267)."
                }
              ],
              "subsubsubacepciones": []
            },
            {
              "id_marcador_html": "— β β )",
              "id_limpio": "— β β )",
              "definicion": "Con sobre.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«¡Oh Ciudad de Dios! de quien | Tantas glorias están dichas, | Cuyos fundamentos, sobre | Montes Santos se eternizan.»",
                  "autor": "Lobo",
                  "referencia_obra": ", Id. ib. 2 (p. 69)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        },
        {
          "id_marcador_html": "— γ )",
          "id_limpio": "— γ )",
          "definicion": "Part.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "X",
              "texto_cita": "«¿Qué mayor riqueza para vna muger que verse eternizada?»",
              "autor": "Lope",
              "referencia_obra": ", Dorotea (ed. facs. Acad. p. 52)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Con en.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Que eternizados en sus luces bellas, | Estampas usurpáis a las estrellas.»",
                  "autor": "Góng.",
                  "referencia_obra": "Octav. al rey Felipe III (Dicc. Autor.)."
                },
                {
                  "marca": "X",
                  "texto_cita": "«La Historia le refiera sus heroicos hechos, cuya gloria eternizada en la estampa le incite a la imitación.»",
                  "autor": "Saav.",
                  "referencia_obra": "Emp. 2 (Dicc. Autor.)."
                },
                {
                  "marca": "X",
                  "texto_cita": "«Venció la suerte, y con presteza suma | La vida al mejor Héroe robó osada. | Mas no importa, que vive eternizada | En láminas, que el tiempo no consuma.»",
                  "autor": "Lobo",
                  "referencia_obra": ", Obr. poética, 2 (p. 238)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        }
      ]
    },
