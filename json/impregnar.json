        },
        {
          "id_marcador_html": "</p>   </i><p ALIGN=\"JUSTIFY\">— </font><font face=\"symbol\">δ</font><font face=\"arial\"> )",
          "id_limpio": "— δ )",
          "definicion": "<i>   <dicautor><a name=\"autor342\"><font color = \"#FF000\"><u>Part.</u></font></b></dicautor></i> Con<i> de.</i> </font><font face=\"arial\" color=\"#000080\">",
          "ejemplos_citas": [
            {
              "texto_cita": "«Estaba cerca un   monte, cuya horrible | Cima lanza fuego y denso humo, | Cubierto en lo demás de una   lustrosa | Costra, señal de oro, que encubrían | Impregnadas de azufre sus entrañas.»",
              "autor": "<a name=\"autor343\"><font color = \"#FF000\"><u>Jovell.</u></font></b>",
              "author": "<a name=\"autor343\"><font color = \"#FF000\"><u>Jovell.</u></font></b>",
