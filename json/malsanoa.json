          "ejemplos_citas": [
            {
              "marca": "X",
              "texto_cita": "«Heredó un joven cierta extensión de territorio próximo a una aldea pero la tierra era malsana y pantanosa.»",
              "autor": "Pagés",
              "referencia_obra": ", Dicc.)."
            },
            {
              "marca": "X",
              "texto_cita": "«En el barrio donde habitaban, la combinación de la niebla y el humo es horrible y malsano.»",
              "autor": "Baroja",
              "referencia_obra": "(Pagés, Dicc.)."
            },
            {
              "marca": "X",
              "texto_cita": "«Te llevaré conmigo. Por este tiempo no es malsano Hato Viejo. Después, ya veremos.»",
              "autor": "Gallegos",
              "referencia_obra": ", Cantaclaro, p. 87."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
