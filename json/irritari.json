          "definicion": "Part. adj. En grado superlativo.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Los nobles irritadísimos contestáronle también sin mesura que la imagen y la reliquia eran de la ciudad.»",
              "autor": "A. Saav.",
              "referencia_obra": "Masan. 1. 2 (5. 36)."
            },
