  "conjugacion": "<dicarbrecont><a name=\"arbre274\"><dicabrev><a name=\"abrev273\"><b><u>Conjug.</u></b></dicabrev></dicarbrecont></font><font   face=\"arial\" color=\"#0000ff\"> </font></b><font face=\"arial\">Tiene estas formas irregulares   <i>desobedezco; desobedezc-a, as, a, amos, áis, an.</p>   </i></font><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br></body></html>\u0000</b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b>",
