      "definicion": "Mitigar, quitar la inflamación ó encendimiento de lo que está enconado (trans.).",
      "marca": "",
      "ejemplos_citas": [
        {
          "marca": "",
          "texto_cita": "«Que él solo por sí solo te perdona | Tus culpas y maldades | Y cura lo herido y desencona, | De tus enfermedades.»",
          "autor": "León",
          "referencia_obra": ", Poes. 3, salmo 102 (4. 606)."
        },
        {
          "marca": "",
          "texto_cita": "«Dígale á su madre si quiere unas cuentas de leche para desenconar los pezones.»",
          "autor": "",
          "referencia_obra": "Pic. Justina, 1. 1. 1 (R. 33. 611)."
        }
      ],
