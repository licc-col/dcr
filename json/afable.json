  "periodo_anteclasico": "<dicarbrecont><a name=\"arbre260\"><dicabrev><a name=\"abrev259\"><b><u>Per. antecl.</u></b></dicabrev></dicarbrecont></b></font><font   face=\"arial\">— <i>Siglo XV</i>: </font><font face=\"arial\" color=\"#000080\">«No      [era allí] ninguna cosa que no fuese afable, hermosa, lícita, honesta.»</font><font face=\"arial\">      <i>Vis. delect</i>. 1. 9 (R. 36. 352<sup>2</sup>).</font>",
