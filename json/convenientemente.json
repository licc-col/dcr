          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Queriendo hacer nuevos hijos, hizo convenientemente un nuevo Padre de quien ellos naciesen.»",
              "autor": "León",
              "referencia_obra": ", Nomb. 1, Padre (3. 108)."
            },
            {
              "marca": "",
              "texto_cita": "«Y si por entrar la carne de Cristo en el pecho no limpio ni convenientemente dispuesto, como agora decía, justamente se le destempla la salud corporal á quien ansí le recibe ---»",
              "autor": "",
              "referencia_obra": "Id. ib. 2, Esposo (3. 246)."
            },
            {
              "marca": "",
              "texto_cita": "«Así como el profeta dijo: Si no creyéredes, no entenderéis; así también convenientemente se puede decir: Si no deseáredes, no amaréis perfectamente.»",
              "autor": "Gran.",
              "referencia_obra": "Mem. vida crist. 7. 3, § 1 (R. 8. 3851)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Sup.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«La cual [ceguedad de los mundanos] convenientísimamente es figurada por aquellas tinieblas de Egipto.»",
                  "autor": "Gran.",
                  "referencia_obra": "Guía, 1. 29, § 4 (R. 6. 1132)."
                }
              ],
              "subsubsubacepciones": [
                {
                  "id_limpio": "—",
                  "definicion": "",
                  "marca": "",
                  "ejemplos_citas": [
                    {
                      "marca": "",
                      "texto_cita": "«Tras de la humildad, convenientísimamente se sigue luégo la fe y confianza, que es la tercera condición de la oración.»",
                      "autor": "",
                      "referencia_obra": "Id. Mem. vida crist. 5. 2, § 3 (R. 8. 2981)."
                    },
                    {
                      "marca": "",
                      "texto_cita": "«Por lo cual convenientísimamente el Salvador quiso celebrar la Pascua nueva cuando se celebraba la vieja.»",
                      "autor": "",
                      "referencia_obra": "Id. Adic. al Mem. med. 14 (R. 8. 5481)."
                    },
                    {
                      "marca": "",
                      "texto_cita": "«Son las dos partes de la divina Sabiduría convenientísimamente figuradas por aquellos dos querubines que estaban á los lados del arca del Testamento.»",
                      "autor": "Doctr.",
                      "referencia_obra": "crist. 2. 2 (R. 11. 951)."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id_marcador_html": "— β )",
          "id_limpio": "— β )",
          "definicion": "Con á.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Es la ley una invariable regla de obrar bien, ó lo que es lo mismo, de obrar convenientemente á los fines y objetos de la sociedad civil á que el hombre es destinado por su naturaleza.»",
              "autor": "",
              "referencia_obra": "Pról. á las Part. (1. IV)."
            }
          ],
