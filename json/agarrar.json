    {
      "id": "c)",
      "definicion": "Refl. met.",
      "marca": "",
      "ejemplos_citas": [
        {
          "marca": "",
          "texto_cita": "«Señora, al llanto te agarra, | Y lloremos á la par.»",
          "autor": "Mto.",
          "referencia_obra": "El valiente justiciero, 3. 1 (R. 39. 343)."
        },
        {
          "marca": "",
          "texto_cita": "«¡Qué silbar!... No, hija, no hay que temer; á buenas aldabas se ha agarrado él para que le silben.»",
          "autor": "Mor.",
          "referencia_obra": "La comedia nueva, 2. 1 (R. 2. 3671)."
        }
      ],
      "subsubsubacepciones": [],
      "subacepciones": []
    },
    {
      "id": "d)",
      "definicion": "Refl. met. Valerse de cualquier medio ó recurso, por frívolo ó peligroso que sea, para lograr lo que se intenta. Con á ó de.",
      "marca": "",
      "ejemplos_citas": [
        {
          "marca": "",
          "texto_cita": "«Agarrarse á ó de un clavo ó hierro ardiendo, de un pelo.»",
          "autor": "Acad.",
          "referencia_obra": "Dicc."
        },
        {
          "marca": "",
          "texto_cita": "«Tengan los críticos paciencia por esta vez, y agárrense de lo que puedan, y no les faltará de qué agarrarse.»",
          "autor": "Forner",
          "referencia_obra": ", Exequias de la lengua castell. (R. 63. 3852)."
        },
        {
          "marca": "",
          "texto_cita": "«Agarrarnos es preciso | Aunque sea de un clavo ardiendo.»",
          "autor": "Saav.",
          "referencia_obra": "Tanto vales cuanto tienes, 3. 7 (4. 83)."
        },
        {
          "marca": "",
          "texto_cita": "«Nunca ha de faltar un pelo | A que agarrarme.»",
          "autor": "Núñez",
          "referencia_obra": "de Arce, Quien debe, paga, 2. 13 (169)."
        }
      ],
      "subsubsubacepciones": [],
      "subacepciones": []
    },
