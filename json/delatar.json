              "id_limpio": "— α α )",
              "definicion": "Con acus. de pers.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Obliga la ley de la caridad á delatar al culpado, siempre que éste padece la pena de la pública infamia.»",
                  "autor": "Núñez",
                  "referencia_obra": ", Emp. 43 (Dicc. Autor.)."
                }
              ],
              "subsubsubacepciones": [
                {
                  "id_limpio": "—",
                  "definicion": "Refl.",
                  "marca": "",
                  "ejemplos_citas": [
                    {
                      "marca": "",
                      "texto_cita": "«Delatarse al juez.»",
                      "autor": "Acad.",
                      "referencia_obra": "Gram."
                    },
                    {
                      "marca": "",
                      "texto_cita": "«¿Cómo he de sufrir que padezca mi amigo por mi culpa? --- No, no; voy á delatarme, á librar su preciosa vida y á morir.»",
                      "autor": "Jovell.",
                      "referencia_obra": "El delincuente honrado, 2. 7 (R. 46. 881)."
                    }
                  ]
                },
                {
                  "id_limpio": "—",
                  "definicion": "Part.",
                  "marca": "",
                  "ejemplos_citas": [
                    {
                      "marca": "",
                      "texto_cita": "«Siempre reserve un oído al delatado; dé espera á la verdad.»",
                      "autor": "Nieremb.",
                      "referencia_obra": "Dict. reales, 3 (Dicc. Autor.)."
                    }
                  ]
                }
              ]
            },
            {
              "id_marcador_html": "— β β )",
              "id_limpio": "— β β )",
              "definicion": "Con acus. de cosa.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Delatar un crimen al juez.»",
                  "autor": "Acad.",
                  "referencia_obra": "Gram."
                },
                {
                  "marca": "",
                  "texto_cita": "«Delató [Annese] inmediatamente al pueblo la propuesta, y mandó ahorcar en el acto al que la había traído.»",
                  "autor": "A. Saav.",
                  "referencia_obra": "Masan. 2.16 (5. 243)."
                }
              ],
              "subsubsubacepciones": [
                {
                  "id_limpio": "—",
                  "definicion": "Part.",
                  "marca": "",
                  "ejemplos_citas": [
                    {
                      "marca": "",
                      "texto_cita": "«La nueva, que delatada | Por Timónides oíste, | Fue industria, con que asegura | Que de buscarle se olviden.»",
                      "autor": "Cald.",
                      "referencia_obra": "Argenis y Poliarco, 1. 16 (R. 7. 4421)."
                    }
                  ]
                }
              ]
            }
          ]
