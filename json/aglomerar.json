                }
              ]
            },
            {
              "id_marcador_html": "</font></p>   <p ALIGN=\"JUSTIFY\"> <font face=\"arial\">— </font><font face=\"symbol\">β</font><font face=\"arial\">      </font><font face=\"symbol\">β</font><font face=\"arial\"> )",
              "id_limpio": "— β β )",
              "definicion": "<i>Pas</i>. </font><font face=\"arial\"   color=\"#000080\">",
              "ejemplos_citas": [
                {
                  "texto_cita": "«Exige la claridad y la belleza de la metáfora que no se aglomeren      muchas sobre un mismo objeto.»",
                  "autor": "<a name=\"autor1555\"><font color = \"#FF000\"><u>Lista</u></font></b>",
                  "author": "<a name=\"autor1555\"><font color = \"#FF000\"><u>Lista</u></font></b>",
                  "referencia_obra": ", <i>Ensayos,      </i>1, p. 55."
                }
              ]
            },
            {
              "id_marcador_html": "</font></p>   <p ALIGN=\"JUSTIFY\"> <font face=\"arial\">— </font><font face=\"symbol\">γ</font><font face=\"arial\">      </font><font face=\"symbol\">γ</font><font face=\"arial\"> )",
              "id_limpio": "— γ γ )",
              "definicion": "<i> <dicautor><a name=\"autor1556\"><font color = \"#FF000\"><u>Part.</u></font></b></dicautor> </i></font><font face=\"arial\"   color=\"#000080\">",
              "ejemplos_citas": [
                {
                  "texto_cita": "«Se habían extirpado á la vez muchos perjudiciales abusos, aglomerados      en la nación por el transcurso de siglos.»",
                  "autor": "",
                  "author": "",
                  "referencia_obra": "</font><font face=\"arial\"> M. de      la Rosa, <i>Esp. del siglo</i>, 2. 10 (5. 83)."
