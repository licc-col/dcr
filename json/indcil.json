            {
              "marca": "",
              "texto_cita": "«En lugar de corregir tus yerros, | Defenderlos indócil preferías.»",
              "autor": "M. de la Rosa",
              "referencia_obra": ", Arte poétic. de Hor. (1. 288)."
            },
            {
              "marca": "X",
              "texto_cita": "«Cuatro [años] de internado y disciplina inglesa, continuos, sin vacaciones, por culpas de su temperamento indócil.»",
              "autor": "Gallegos",
              "referencia_obra": ", Canaima, 1 (p. 17)."
            },
            {
              "marca": "X",
              "texto_cita": "«La madre está desesperada por el carácter indócil que el niño tiene desde que va a la escuela.»",
              "autor": "Dicc. Planeta",
              "referencia_obra": "."
            }
          ],
          "subsubsubacepciones": [
            {
