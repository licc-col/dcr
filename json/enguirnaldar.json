      "subacepciones": [
        {
          "id_marcador_html": "</p>   <p ALIGN=\"JUSTIFY\">— </font><font face=\"symbol\">α</font><font face=\"arial\"> ) </font>",
          "id_limpio": "— α )",
          "definicion": "<font   face=\"arial\" color=\"#000080\"></font>",
          "ejemplos_citas": [
            {
              "texto_cita": "«Comienza el ruiseñor quejas de amores, | Y enguirnaldan   sus bueyes los pastores.»",
              "autor": "<a name=\"autor1704\"><font color = \"#FF000\"><u>Valb.</u></font></b>",
              "author": "<a name=\"autor1704\"><font color = \"#FF000\"><u>Valb.</u></font></b>",
              "referencia_obra": "<i>Bern</i>. 5 (R. 17. 193<sup>2</sup>).   </font><font face=\"arial\" color=\"#000080\">"
            },
            {
              "texto_cita": "«De estos [gusanillos que resplandecen], como   mejor puedo, ensartando a mi despacio gran número en un hilo, cuando hace escuro, suelo   enguirnaldar mi caperuza.»",
              "autor": "",
              "author": "",
              "referencia_obra": "</font><font face=\"arial\"> Id. <i>Siglo de oro</i>, 4 (79)."
            }
          ],
          "subsubacepciones": [
            {
              "id_marcador_html": "</p>   <p ALIGN=\"JUSTIFY\">— </font><font face=\"symbol\">α</font><font face=\"arial\"> </font><font face=\"symbol\">α</font><font face=\"arial\"> )",
              "id_limpio": "— α α )",
              "definicion": "Con la <dicabrev><a name=\"abrev1705\"><b><u>prep.</u></b></dicabrev> <i>con</i>, para indicar el medio   o instrumento. RAE </font><font face=\"arial\" color=\"#000080\">",
              "ejemplos_citas": [
                {
                  "texto_cita": "«Al principio del verano y   de las aguas, celebran una fiesta que llaman Tlaxuchimace; con todas las maneras de rosas   y flores que pueden ofrecen las en el templo, enguirnaldando los ýdolos con ellas.»",
                  "autor": "",
                  "author": "",
                  "referencia_obra": "</font><font   face=\"arial\"> L. Gómara, <i>Hist. Indías</i>, 2ª <i>pte</i>. (ed. 1553, fol. 131   rº). </p>   <p ALIGN=\"JUSTIFY\">— <dicabrev><a name=\"abrev1706\"><b><u>met.</u></b></dicabrev> </font><font face=\"arial\" color=\"#000080\">"
                },
                {
                  "texto_cita": "«Plátanos   frescos de esta verde falda, | Sombríos sauces, cedros de olor llenos, | Que os holgáis   con los céfiros serenos | Y enguirnaldáis con cercos de esmeralda Los prados siempre   amenos.»",
                  "autor": "<a name=\"autor1707\"><font color = \"#FF000\"><u>Iglesias</u></font></b>",
                  "author": "<a name=\"autor1707\"><font color = \"#FF000\"><u>Iglesias</u></font></b>",
                  "referencia_obra": ", <i>idil</i>. 4 (R. 67. 446<sup>2</sup>)."
                }
              ]
            },
            {
              "id_marcador_html": "</p>   <p ALIGN=\"JUSTIFY\">— </font><font face=\"symbol\">β</font><font face=\"arial\"> </font><font face=\"symbol\">β</font><font face=\"arial\"> )",
              "id_limpio": "— β β )",
              "definicion": "Con <i>de</i>, para indicar lo mismo que en el   caso anterior. </font><font face=\"arial\" color=\"#000080\">",
              "ejemplos_citas": [
                {
                  "texto_cita": "«Mi lira, que amoroso | El padre   Delio enguirnaldó de flores.»",
                  "autor": "<a name=\"autor1708\"><font color = \"#FF000\"><u>Lista</u></font></b>",
                  "author": "<a name=\"autor1708\"><font color = \"#FF000\"><u>Lista</u></font></b>",
                  "referencia_obra": ", <i>Poes. amor</i>.   23 (R. 67. 330<sup>2</sup>)."
                }
              ]
            },
            {
              "id_marcador_html": "</p>   <p ALIGN=\"JUSTIFY\">— </font><font face=\"symbol\">γ</font><font face=\"arial\"> </font><font face=\"symbol\">γ</font><font face=\"arial\"> )",
              "id_limpio": "— γ γ )",
              "definicion": "<dicabrev><a name=\"abrev1709\"><b><u>met.</u></b></dicabrev> Con <i>en</i>, para indicar lo mismo que   en los casos anteriores. </font><font face=\"arial\" color=\"#000080\">",
              "ejemplos_citas": [
                {
                  "texto_cita": "«En rosa y lirio bello   | Cien mayos enguirnalden tu cabello.»",
                  "autor": "<a name=\"autor1710\"><font color = \"#FF000\"><u>Lista</u></font></b>",
                  "author": "<a name=\"autor1710\"><font color = \"#FF000\"><u>Lista</u></font></b>",
                  "referencia_obra": ", <i>Odas</i>, 2   (R. 67. 405<sup>1</sup>)."
                }
              ]
            }
          ]
        },
        {
          "id_marcador_html": "</p>   <p ALIGN=\"JUSTIFY\">— </font><font face=\"symbol\">δ</font><font face=\"arial\"> )",
          "id_limpio": "— δ )",
          "definicion": "<i>Refl</i>.   Con <i>de</i>. RAE </font><font face=\"arial\" color=\"#000080\">",
          "ejemplos_citas": [
            {
              "texto_cita": "«Por seis veces vimos al   chico enguirnaldarse de verde, después de la victoria.»",
              "autor": "<a name=\"autor1711\"><font color = \"#FF000\"><u>Darío</u></font></b>",
              "author": "<a name=\"autor1711\"><font color = \"#FF000\"><u>Darío</u></font></b>",
              "referencia_obra": ", <i>Cuentos</i> (ed. 1950, p. 125)."
            }
          ],
          "subsubacepciones": [
            {
              "id_marcador_html": "</p>   <p ALIGN=\"JUSTIFY\">— </font><font face=\"symbol\">α</font><font face=\"arial\"> </font><font face=\"symbol\">α</font><font face=\"arial\"> )",
              "id_limpio": "— α α )",
              "definicion": "<dicabrev><a name=\"abrev1712\"><b><u>met.</u></b></dicabrev> </font><font face=\"arial\" color=\"#000080\">",
              "ejemplos_citas": [
                {
                  "texto_cita": "«Y   cuando el alba abría | En el oriente de oro los racimos | De que se cuaja y se   enguirnalda el día, | A Ibiza quedar por popa vimos.»",
                  "autor": "<a name=\"autor1713\"><font color = \"#FF000\"><u>Valb.</u></font></b>",
                  "author": "<a name=\"autor1713\"><font color = \"#FF000\"><u>Valb.</u></font></b>",
                  "referencia_obra": "<i>Bern</i>.   7 (R. 17. 208<sup>2</sup>)."
                }
              ]
            }
