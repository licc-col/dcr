    {
      "id": "a)",
      "definicion": "Producir una cosa ruido o sonido continuado, seguido y bronco (intrans.).",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "X",
              "texto_cita": "«Ruega ligera, | Zumbe el pandero, | Y háganse rajas las castañuelas.»",
              "autor": "",
              "referencia_obra": "Montoro, Obr. poét. 2. pl. 432 (Dicc. Autor.)."
            },
            {
              "marca": "X",
              "texto_cita": "«Llégase, por último, a la Bochetta, que es una garganta del Apenino, en su mayor altura por aquella parte, donde zumban los vientos.»",
              "autor": "",
              "referencia_obra": "Id. Obr. póst. (1. 500)."
            },
            {
              "marca": "X",
              "texto_cita": "«Queda en hondo silencio la gran plaza | Por un momento, y enseguida zumba | La voz universal de Él es, ya sale.»",
              "autor": "A. Saav.",
              "referencia_obra": "Moro expós. 11 (2. 407)."
            },
            {
              "marca": "X",
              "texto_cita": "«Ya se acerca zumbando | El eco grande del clamor guerrero.»",
              "autor": "Quint.",
              "referencia_obra": "El arm. de las prov. esp. (R. 19. 102)."
            },
            {
              "marca": "X",
              "texto_cita": "«Zumban las moscas gordas y azules; corren las cochinillas tropezando despavoridas; se ensortijan y atirantan las lombrices en la frialdad de su suco.»",
              "autor": "Miró",
              "referencia_obra": ", Años y leguas, p. 32."
            },
            {
              "marca": "X",
              "texto_cita": "«De esa mano, que le hace en remolino | Al torno girador zumbar sonoro, | Brota el hilo y al hueso se devana.»",
              "autor": "Hartz.",
              "referencia_obra": "Poes. La campana, p. 416."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Con dat. Además con la expresión a manera de.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«A manera de tábanos cerquen, zumben, embistan, acosen y acribillen a todo botarate.»",
                  "autor": "Mor.",
                  "referencia_obra": "Obr. póst. (2. 254)."
                }
              ],
              "subsubsubacepciones": [
                {
                  "id_limpio": "—",
                  "definicion": "Además con por.",
                  "marca": "",
                  "ejemplos_citas": [
                    {
                      "marca": "X",
                      "texto_cita": "«Apenas el hosco miro, | Cuando de un brinco que dio | Me zumba por los oídos.»",
                      "autor": "Lope",
                      "referencia_obra": ", Con su pan se lo coma, p. 306 (Fdz. Gómez, Vocab. de Lope)."
                    },
                    {
                      "marca": "X",
                      "texto_cita": "«Ya me parece que sus saetas me zumban por los oídos.»",
                      "autor": "Cerv.",
                      "referencia_obra": "Quij. 1. 23 (R. 1. 306)."
                    }
                  ]
                }
              ]
            },
            {
              "id_marcador_html": "— β β )",
              "id_limpio": "— β β )",
              "definicion": "Con la expresión alrededor de.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Las abejas zumbaban alrededor de los cerezos en flor.»",
                  "autor": "Dicc. Planeta",
                  "referencia_obra": "."
                }
              ],
              "subsubsubacepciones": []
            },
            {
              "id_marcador_html": "— γ γ )",
              "id_limpio": "— γ γ )",
              "definicion": "Con la prep. con.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«El trueno, con horror zumbando, | Rompe la alta región.»",
                  "autor": "Mor.",
                  "referencia_obra": "Obr. (3. 309)."
                }
              ],
              "subsubsubacepciones": []
            },
            {
              "id_marcador_html": "— δ δ )",
              "id_limpio": "— δ δ )",
              "definicion": "Con la combinación de... en.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Las piedras | Son las que irán zumbando de una en una, | Desvíese le digo treinta veces, | Mire no desembrace.»",
                  "autor": "Lope",
                  "referencia_obra": ", El secretario de sí mismo, p. 99 (Fdz. Gómez, Vocab. de Lope)."
                }
              ],
              "subsubsubacepciones": []
            },
            {
              "id_marcador_html": "— ε ε )",
              "id_limpio": "— ε ε )",
              "definicion": "Con en, que señala:",
              "marca": "",
              "ejemplos_citas": [],
              "subsubsubacepciones": [
                {
                  "id_limpio": "—",
                  "definicion": "el modo.",
                  "marca": "",
                  "ejemplos_citas": [
                    {
                      "marca": "X",
                      "texto_cita": "«Hínchase el corazón, el pie vacila, | Y a andar se niega; por sus miembros todos, | Que la vida abandona, un sudor frío | Vaga y triste temblor; turbios los ojos, | Y en ronco son zumbando los oídos, | Ni ve ni escucha.»",
                      "autor": "Quint.",
                      "referencia_obra": "Poes. A Fileno (R. 19. 162)."
                    },
                    {
                      "marca": "X",
                      "texto_cita": "«Murmuran oír lo bajo, | Zumbando en voces concas, | El zángano, la avispa, | El tábano y la mosca.»",
                      "autor": "Pagés",
                      "referencia_obra": ", Dicc.)."
                    }
                  ]
                },
                {
                  "id_limpio": "—",
                  "definicion": "El lugar.",
                  "marca": "",
                  "ejemplos_citas": [
                    {
                      "marca": "X",
                      "texto_cita": "«Aves canoras, revolando alegres | Libres como yo, rumor suave | Que en torno zumbe del panal hibleo, | Y leves auras espirando olores: | Esto a mi corazón le basta.»",
                      "autor": "Mor.",
                      "referencia_obra": "epíst. 1 (R. 2. 5811)."
                    },
                    {
                      "marca": "X",
                      "texto_cita": "«Mientras la fusilería y artillería zumbaban en la Plaza Mayor, ustedes roncaban en el Hospicio.»",
                      "autor": "Mor.",
                      "referencia_obra": "Obr. póst. (2. 423)."
                    },
                    {
                      "marca": "X",
                      "texto_cita": "«Zumba en el sol un enjambre de moscardones verdes.»",
                      "autor": "Gallegos",
                      "referencia_obra": "(Gran encicl. Larousse)."
                    },
                    {
                      "marca": "X",
                      "texto_cita": "«A par del trueno el huracán bramaba, | Y del templo en la bóvedas zumbaba.»",
                      "autor": "Espronc.",
                      "referencia_obra": "(Pagés, Dicc.)."
                    },
                    {
                      "marca": "X",
                      "texto_cita": "«Yo amo el asnillo fiel y sincero | Que va marchando por el sendero, | Va temeroso de las abejas | Que ásperas zumban en sus orejas.»",
                      "autor": "",
                      "referencia_obra": "Castillo, Versiones (El árbol, p. 115)."
                    }
                  ]
                }
              ]
            },
            {
              "id_marcador_html": "— ζ ζ )",
              "id_limpio": "— ζ ζ )",
              "definicion": "Sustantivado. Con de sujetivo.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«¡Al campo! digo yo como Tancredo; | Mas no en verdad al campo de batalla, | Donde el tronar del bronce infunde miedo | Y el zumbar de la bala y la metralla; | Ni al campo donde el bárbaro denuedo | De un falso honor, teutónica antigualla, | Dos pechos pone a dos contrarias puntas | Por ofensas reales o presuntas.»",
                  "autor": "Bello",
                  "referencia_obra": ", Poes. p. 602."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        },
        {
          "id_marcador_html": "— γ )",
          "id_limpio": "— γ )",
          "definicion": "Forma la expresión zumbarle los oídos:",
          "marca": "",
          "ejemplos_citas": [],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Tener la sensación de oir un sonido que no existe.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Sentía los músculos agarrotados, le zumbaban los oídos.»",
                  "autor": "Vargas Llosa",
                  "referencia_obra": "(Gran encicl. Larousse)."
                },
                {
                  "marca": "X",
                  "texto_cita": "«De repente me sentí mal; se me nubló la vista y empezaron a zumbarme los oídos.»",
                  "autor": "Dicc. Planeta",
                  "referencia_obra": "."
                }
              ],
              "subsubsubacepciones": []
            },
            {
              "id_marcador_html": "— β β )",
              "id_limpio": "— β β )",
              "definicion": "Se dice con referencia a alguien a quien se está criticando.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Si fuera quien yo veo desde aquí los que hablaban en nosotros, zumbárannos los oídos.»",
                  "autor": "P. Mexía",
                  "referencia_obra": ", Coloq. 2 (p. 65)."
                },
                {
                  "marca": "X",
                  "texto_cita": "«¡Cómo deben de estarle zumbando los oídos.»",
                  "autor": "Moliner",
                  "referencia_obra": ", Dicc."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        }
      ]
    },
    {
