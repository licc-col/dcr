              "autor": "",
              "author": "",
              "referencia_obra": "</font><font face=\"arial\"><i> Gran encicl.   Larousse, <dicabrev><a name=\"abrev341\"><b><u>sb. voc.</u></b></dicabrev> impregnación.</i>"
