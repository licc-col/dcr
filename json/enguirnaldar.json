  "periodo_anteclasico": "<dicarbrecont><a name=\"arbre1717\"><dicabrev><a name=\"abrev1716\"><b><u>Per. antecl.</u></b></dicabrev></dicarbrecont></font><font   face=\"arial\" color=\"#0000ff\"> </font></b><font face=\"arial\">(Nótese la variante <i>guírnaldar</i>.)   Siglo XV: + </font><font face=\"arial\" color=\"#000080\">«La torre era guirnaldada de   barandas al derredor.»</font><font face=\"arial\"> <i>Crón. Álv. de Luna</i>,   104 (309).</p>   </font><b><font face=\"arial\" color=\"#800080\">",
