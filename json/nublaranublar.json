          "definicion": "Prnl.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "X",
              "texto_cita": "«Sus ojos se nublaron y cayó desvanecido al suelo.»",
              "autor": "Dicc. Planeta",
              "referencia_obra": "."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
