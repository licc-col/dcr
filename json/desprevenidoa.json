        {
          "id_marcador_html": "</p>   <p ALIGN=\"JUSTIFY\">— </font><font face=\"symbol\">β</font><font face=\"arial\"> )</font>",
          "id_limpio": "— β )",
          "definicion": "<font   face=\"arial\" color=\"#0000ff\"> </font><font face=\"arial\">Con <i>de</i>, para</font><font   face=\"arial\" color=\"#0000ff\"> </font><font face=\"arial\">expresar lo que no se ha previsto   ó de que uno se halla falto. </font><font face=\"arial\" color=\"#000080\"></font>",
          "ejemplos_citas": [
