  "ortografia": "<b><font face=\"arial\" color=\"#800080\"></b></font> <dicarbrecont><a name=\"arbre1177\"><dicabrev><a name=\"abrev1176\"><b><u>Ortogr.</u></b></dicabrev></dicarbrecont></font><font   face=\"arial\" color=\"#0000ff\"> </font></b><font face=\"arial\">Antes de <i>e</i> se pone <i>c</i>:   <i>embracen, embracemos. </i>Hasta principios del siglo pasado se escribía <i>embraçar</i>.</font></p><font face=\"arial\">   <p ALIGN=\"JUSTIFY\"> </p>   <p ALIGN=\"JUSTIFY\"> </p>   </font><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br></body></html>\u0000</b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b>",
