                {
                  "marca": "X",
                  "texto_cita": "«Yo os reconocía por mi Dios y por mi Señor, o dulce Jesus mío! Pues cómo he podido ser tan ciego, tan ingrato, tan indócil?»",
                  "autor": "Isla",
                  "referencia_obra": ", Año Christiano, 13 (p. 209)."
                }
              ]
            }
          ],
          "subsubacepciones": [
