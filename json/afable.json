              "texto_cita": "«Sé á tus cabos      obediente, </font><font face=\"symbol\">|</font><font face=\"arial\" color=\"#000080\"> Afable      á tus compañeros.»",
              "autor": "<a name=\"autor257\"><font color = \"#FF000\"><u>A. Saav.</u></font></b>",
