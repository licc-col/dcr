  "conjugacion": "<font face=\"arial\" color=\"#800080\"><b></b></font> <dicarbrecont><a name=\"arbre2103\"><dicabrev><a name=\"abrev2102\"><b><u>Conjug.</u></b></dicabrev></dicarbrecont></b></font><font   face=\"arial\"> Sigue en un todo la del simple <i>comedirse</i>.</font></p>   <font face=\"arial\" color=\"#0000ff\"><b><p ALIGN=\"JUSTIFY\"> </p>   <p ALIGN=\"JUSTIFY\"> </p>   </b></font><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br></body></html>\u0000</b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b>",
