              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«¿Zumbáis de Alphonso Correa?»",
                  "autor": "Góng.",
                  "referencia_obra": "Obr. fol. 73 (Dicc. Autor.)."
                }
              ],
              "subsubsubacepciones": []
            },
            {
              "id_marcador_html": "— β β )",
              "id_limpio": "— β β )",
              "definicion": "Prnl.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Sin duda que serán mejores vuestros comediantes de Lisboa. Dijo entonces zumbándose el marqués de Zenete.»",
                  "autor": "Isla",
                  "referencia_obra": "(Gran encicl. Larousse)."
                },
                {
                  "marca": "X",
                  "texto_cita": "«Lo que más me molestó fue que hiciera la pregunta zumbándose.»",
                  "autor": "",
                  "referencia_obra": "Dicc. Planeta."
                }
              ],
              "subsubsubacepciones": []
            },
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Con de, para señalar la persona de la cual se burla.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Quintiliano y Herennio le abrieron la guerra [a Feijoo], comenzando a zumbarse de su latín.»",
                  "autor": "Forner",
                  "referencia_obra": ", Exequias de la leng. castell. (R. 63. 4051)."
                }
              ],
              "subsubsubacepciones": [
                {
