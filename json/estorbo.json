          "ejemplos_citas": [
            {
              "texto_cita": "«Dolor de cabeza o muelas era poco estorbo; pero dijimos   que nos dolían mucho las tripas.»",
              "autor": "<a name=\"autor442\"><font color = \"#FF000\"><u>Quev.</u></font></b>",
