    {
      "id": "c)",
      "definicion": "Estar una cosa tan inmediata, que falte poco para llegar a ella (intrans.). Hablando de las cosas inmateriales. Con dat.",
      "marca": "",
      "ejemplos_citas": [
        {
          "marca": "X",
          "texto_cita": "«Fulano no tiene aún cincuenta años; pero le zumban: esto es, le falta poco para cumplirlos.»",
          "autor": "",
          "referencia_obra": "Dicc. Autor."
        }
