          "definicion": "<font   face=\"arial\" color=\"#000080\"> X</font>",
          "ejemplos_citas": [
            {
              "texto_cita": "«Que esta gente tiene pasacalles infusos y guitarra   gratis data. Era de ver puntear a unos y rasgar a otros.»",
              "autor": "<a name=\"autor2\"><font color = \"#FF000\"><u>Quev.</u></font></b>",
              "author": "<a name=\"autor2\"><font color = \"#FF000\"><u>Quev.</u></font></b>",
              "referencia_obra": "<i>Sueños</i>, 1 (Cl. C. 31. 208)."
