{
  "lema": "GUARTE.",
  "categoria_gramatical": "interj.",
  "introduccion": "Voz con que se advierte o avisa a uno que se aparte del peligro que le amenaza.",
  "acepciones": [
    {
      "id": "",
      "definicion": "",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Pues guarte y vive con tiento.»",
              "autor": "Montem.",
              "referencia_obra": "Diana, 3 (p. 107)."
            },
            {
              "marca": "+",
              "texto_cita": "«Guárdate del mundo, pues va errado ---; guarte, no le creas, pues es fementido.»",
              "autor": "Guev.",
              "referencia_obra": "Oratorio, 22 (p. 584)."
            },
            {
              "marca": "+",
              "texto_cita": "«Guarte, Guillermo, guarte, y no hinches la celda de niñerías.»",
              "autor": "",
              "referencia_obra": "Id. ib. 48 (p. 714)."
            },
            {
              "marca": "X",
              "texto_cita": "«Hay que siento gritar, por quanto Eolo | Corre, y alcança guarte, guarte, guarte: | Mas no podré guardarme, de que modo | De ti gran Dios, que todo eres en todo.»",
              "autor": "Aldana",
              "referencia_obra": ", Obr. complet. (BALH. 23. 100)."
            },
            {
              "marca": "",
              "texto_cita": "«Camina pues, y guarte.»",
              "autor": "Cerv.",
              "referencia_obra": "La casa de los celos, 1 (Com. 1. 74)."
            },
            {
              "marca": "",
              "texto_cita": "«Guarte, guarte ¡ay hijo! muero; | Que don Diego, sin tirarte, | Te va buscando la parte | Donde te falta el acero.»",
              "autor": "G. de Castro",
              "referencia_obra": ", Las mocedades del Cid, 3 (R. 43. 2752)."
            },
            {
              "marca": "",
              "texto_cita": "«Y guarte no sueltes la corteza de la mano porque no se te vaya tu deseada presa.»",
              "autor": "Almazán",
              "referencia_obra": ", Mono, 1. 13 (p. 151)."
            },
            {
              "marca": "",
              "texto_cita": "«¡Ay, triste! guarte, | Guarte, que está cercano el principio.»",
              "autor": "Jovell.",
              "referencia_obra": "sát. 1 a Arnesto (R. 46. 341)."
            },
            {
              "marca": "",
              "texto_cita": "«Pero guarte, | Que si no cabe en su favor [de las Musas] engaño, | Cabe en el culto que le da insolente | El vano adorador.»",
              "autor": "",
              "referencia_obra": "Id. epíst. a Bermudo (R. 46. 431)."
            },
            {
              "marca": "",
              "texto_cita": "«Carlos, guarte, no hagas en la tuya [tu lira] | Tal injuria a tu ser.»",
              "autor": "",
              "referencia_obra": "Id. epíst. 2 A Posidonio (R. 46. 461)."
            },
            {
              "marca": "",
              "texto_cita": "«Guarte y no te olvides del atavío de las buenas obras.»",
              "autor": "Sig.",
              "referencia_obra": "Vida de S. Jer. 4. 7 (p. 304)."
            },
            {
              "marca": "",
              "texto_cita": "«¡Ay! guarte que el encanto | De margen sevillana lisonjera | Detenga tu carrera.»",
              "autor": "D. Gonz.",
              "referencia_obra": "El triunfo de Manzanares (R. 61. 1931)."
            },
            {
              "marca": "",
              "texto_cita": "«Con un listón de rosa | Le suspendo a tu cuello, | Guarte no se desprenda | Con tu rápido vuelo.»",
              "autor": "Mel.",
              "referencia_obra": "La paloma de Filis, 14 (R. 63. 1133)."
            },
            {
              "marca": "",
              "texto_cita": "«Guarte no sea que los dioses todos, | Cuantos son del Olimpo habitadores, | Defenderte no puedan de mis iras.»",
              "autor": "",
              "referencia_obra": "Hermosilla, Iliada. 1 (1. 28)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
