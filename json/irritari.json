{
  "lema": "IRRITAR. (I)",
  "categoria_gramatical": "v.",
  "introduccion": "",
  "acepciones": [
    {
      "id": "a)",
      "definicion": "Excitar, provocar o avivar un afecto o pasión (trans.).",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«No se debe consentir que estas tales mujeres se pongan a las puertas donde irriten la concupiscencia de los que las ven.»",
              "autor": "Ávila",
              "referencia_obra": ", Epíst. 4, Instrucc. §5 (7. 263)."
            },
            {
              "marca": "",
              "texto_cita": "«Él tomaba lo necesario para sustentar la vida, mas no para irritar la gula.»",
              "autor": "Gran.",
              "referencia_obra": "Vida de Áv., 4. 4 (R. 11. 4712)."
            },
            {
              "marca": "X",
              "texto_cita": "«Yo estimo valor tan grande; | Mas por no irritar la ira, | Me quitaré de delante.»",
              "autor": "Cald.",
              "referencia_obra": "El pintor de su deshonra, 3 (Cl. C. 142. 231)."
            },
            {
              "marca": "",
              "texto_cita": "«La misma dificultad irrita el deseo.»",
              "autor": "Jovell.",
              "referencia_obra": "Corresp. con Posada (R. 50. 2041)."
            },
            {
              "marca": "",
              "texto_cita": "«La fuga de la ninfa | Irrita mi deseo.»",
              "autor": "Jovell.",
              "referencia_obra": "idil. A Mireo (R. 46. 61)."
            },
            {
              "marca": "",
              "texto_cita": "«Notas --- tan cortas en número y extensión, que no hacen sino irritar la curiosidad, y aumentar el deseo de mayores y más extensas explicaciones.»",
              "autor": "Clem.",
              "referencia_obra": "Coment. 1 (p. xxxvii)."
            },
            {
              "marca": "",
              "texto_cita": "«Esa bondad, en vez de cautivarlos, | Su orgullo irrita y su osadía alienta.»",
              "autor": "V. de la Vega",
              "referencia_obra": ", La muerte de César, 1. 1 (p. 300)."
            },
            {
              "marca": "X",
              "texto_cita": "«¿Quién irrita | La cólera a Cairvar armipotente?»",
              "autor": "Espronc.",
              "referencia_obra": "Poes. 1 (Cl. C. 47. 121)."
            },
            {
              "marca": "X",
              "texto_cita": "«Sin saber por qué, algunas despertaban en mí vehementes antipatías que procuraba disimular. Su presencia irritaba mis males.»",
              "autor": "P. Galdós",
              "referencia_obra": ", Lo prohibido (Cl. Castal. 34. 90)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Con a.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Desdeñarle era irritar | A una violencia sus iras.»",
                  "autor": "Alarcón",
                  "referencia_obra": ", Todo es ventura, 2. 9 (R. 20. 1282)."
                },
                {
                  "marca": "",
                  "texto_cita": "«El arráez quisiera que dejaran los remos y se entregaran, por no irritar a enojo al capitán que nuestras galeras regía.»",
                  "autor": "Cerv.",
                  "referencia_obra": "Quij. 2. 63 (R. 1. 5391)."
                }
              ],
              "subsubsubacepciones": []
            },
            {
              "id_marcador_html": "— β β )",
              "id_limpio": "— β β )",
              "definicion": "Con la prep. con, que señala el medio o instrumento.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "+",
                  "texto_cita": "«Convernía que no dejasen parar a hombre en la dicha casa, porque de estar allí irritan a la misma concupisciencia con las muchas ocasiones que para ello hay.»",
                  "autor": "Ávila",
                  "referencia_obra": ", Epist. 1. 11 (1. 341)."
                },
                {
                  "marca": "",
                  "texto_cita": "«¿Que tema yo a mis vasallos | Te atreves a aconsejarme, | Cuando hubiera de irritarme | Con valor a castigallos?»",
                  "autor": "Alarcón",
                  "referencia_obra": ", La Manganilla de Melilla, 1 (R. 20. 3053)."
                },
                {
                  "marca": "",
                  "texto_cita": "«Paga les dan, con premio los irritan, | Y al vulgo fingen causa religiosa.»",
                  "autor": "Hojeda",
                  "referencia_obra": ", Crist. 3 (R. 17. 4242)."
                },
                {
                  "marca": "X",
                  "texto_cita": "«El comerciante cuenta en fracciones de rupias sus ganancias y el comprador irrita su propia hambre con un puñadito de garbanzos.»",
                  "autor": "Zalamea",
                  "referencia_obra": ", El sueño, 1 (p. 12)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        },
        {
          "id_marcador_html": "— β )",
          "id_limpio": "— β )",
          "definicion": "Pnrl. Con a, para indicar la causa.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Ruego, y irrítase al ruego; | Hablo, y no quiere escucharme.»",
              "autor": "Rojas",
              "referencia_obra": ", El más impropio verdugo, 2 (R. 54. 1821)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "met. Con la prep. con.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«La ambición se irrita con promesas, no se satisface.»",
                  "autor": "Quev.",
                  "referencia_obra": "M. Bruto (R. 23. 1412)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        }
