          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Y tratándome como á alma condenada me abochornaban los tuétanos y me escaldaban las pajarillas.»",
              "autor": "",
              "referencia_obra": "Esteb. Gonz. fol. 357 (Dicc. Autor.)"
            },
            {
              "marca": "",
              "texto_cita": "«Convertiréme en ceniza, | Pues tus soles me abochornan.»",
              "autor": "Quev.",
              "referencia_obra": "Musa 6, rom. 2 (R. 69. 1541)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Part.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Como el diablo, del cielo | Huyendo, á la tierra baja [el agua], | El invierno tiritando | Y el verano abuchornada.»",
                  "autor": "Alarcón",
                  "referencia_obra": ", El semejante á si mismo, 1. 1 (R. 20. 641)."
                },
                {
                  "marca": "",
                  "texto_cita": "«Una bermejuela abuchornada de rizos, y con más colores que barba teñida, dijo: Ya sé lo que es, venga el libro.»",
                  "autor": "Quev.",
                  "referencia_obra": "Perinola (R. 48. 4642)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        }
      ]
    },
