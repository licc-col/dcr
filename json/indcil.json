              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Ser el florido vástago de una raza imperiosa | Y haber nacido bello, libre, fuerte, altanero, | Y mantener mi indócil juventud victoriosa | Limpia y bruñida como la hoja de un acero.»",
                  "autor": "Maya",
                  "referencia_obra": ", Obra poétic. 1 (p. 42)."
