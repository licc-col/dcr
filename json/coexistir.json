            {
              "marca": "",
              "texto_cita": "«Coexistir con Homero.»",
              "autor": "Acad.",
              "referencia_obra": "Gram."
            },
            {
              "marca": "",
              "texto_cita": "«En esta forma [cantaba] el atributo es, respecto de la cosa pasada con la cual coexiste, lo mismo que el presente respecto del momento en que se habla, es decir, que la duración de la cosa pasada con que se le compara puede no ser mas que una parte de la suya.»",
              "autor": "Bello",
              "referencia_obra": ", Gram. § 287, a."
            }
