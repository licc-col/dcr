        {
          "marca": "",
          "texto_cita": "«Al frondoso | Bosque no da [el viento] descanso, | Y su penacho umbroso | Balancea con silbo sonoroso.»",
          "autor": "Arriaza",
          "referencia_obra": ", oda 5 (R. 67. 651)."
        }
      ],
