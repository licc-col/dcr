          "ejemplos_citas": [
            {
              "texto_cita": "«Y si la utilidad de tales obras es de   influencia general y extensiva a todas las clases, es claro que aquellos individuos   reportarán utilidad mayor, que gozan de mayor fortuna, y que deben contribuir conforme a   ella.»",
              "autor": "<a name=\"autor847\"><font color = \"#FF000\"><u>Jovell.</u></font></b>",
              "author": "<a name=\"autor847\"><font color = \"#FF000\"><u>Jovell.</u></font></b>",
              "referencia_obra": "<i> Ley agraria, </i>3ª<i> clase</i> (R. 46. 133<sup>1</sup>).   </font><font face=\"arial\" color=\"#000080\">"
            },
            {
              "texto_cita": "«Y consta que les pidió fuese su decisión   extensiva a todo el reino, a lo que se negaron constantemente, manifestando que sus   facultades no pasaban de los muros de la ciudad.»",
              "autor": "<a name=\"autor848\"><font color = \"#FF000\"><u>A. Saav.</u></font></b>",
              "author": "<a name=\"autor848\"><font color = \"#FF000\"><u>A. Saav.</u></font></b>",
              "referencia_obra": "<i>   Masan.</i> 1. 3 (5. 40).</font><font face=\"arial\" color=\"#000080\"> X"
            },
            {
              "texto_cita": "«La invitó a ella e   hizo extensiva la invitación a sus amigas.»",
              "autor": "<a name=\"autor849\"><font color = \"#FF000\"><u>Moliner</u></font></b>",
              "author": "<a name=\"autor849\"><font color = \"#FF000\"><u>Moliner</u></font></b>",
              "referencia_obra": ",<i> Dicc.   <dicabrev><a name=\"abrev850\"><b><u>sb. voc.</u></b></dicabrev></i></font><font face=\"arial\" color=\"#000080\"> X"
            },
            {
              "texto_cita": "«Esta particularidad es extensiva a   otros animales de la misma familia.»",
              "autor": "",
              "author": "",
              "referencia_obra": "</font><font face=\"arial\"> Id.<i> ib.</i>"
            }
          ],
