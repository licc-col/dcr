          "ejemplos_citas": [
            {
              "texto_cita": "«Pero descárase Venus á los veinte [años de la edad del   hombre] y reina con grande tiranía hasta los treinta.»",
              "autor": "<a name=\"autor1521\"><font color = \"#FF000\"><u>Gracián</u></font></b>",
              "author": "<a name=\"autor1521\"><font color = \"#FF000\"><u>Gracián</u></font></b>",
