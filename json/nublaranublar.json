              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Con que al cabo de la jornada hallé el carro de mi capitán adonde yo llevaba la indigestible mercancía mui vacío, y mi bolsa muy anublada.»",
                  "autor": "",
                  "referencia_obra": "Esteb. Gonz. (Dicc. Autor.)."
                }
              ],
