            {
              "id_marcador_html": "α α )",
              "id_limpio": "α α )",
              "definicion": "Descargar el nublado: llover.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Mientras gastáis tanta flema | Descargar puede el nublado. | —Si dais un golpe de estado | Mayor será el anatema.»",
                  "autor": "Bretón",
                  "referencia_obra": "(Pagés, Dicc.)."
                }
              ],
              "subsubsubacepciones": [
                {
                  "id_limpio": "—",
                  "definicion": "Desahogar la cólera.",
                  "marca": "",
                  "ejemplos_citas": [
                    {
                      "marca": "X",
                      "texto_cita": "«Mas como vuestra merced le deshonró tan sin propósito, y le dijo tantas villanías, encendiólese la cólera, y como no la pudo vengar en vuesara merced, cuando se vio solo descargó sobre mí el nublado, de modo que me parece que no seré más hombre en toda mi vida.»",
                      "autor": "Cerv.",
                      "referencia_obra": "Quij. 1. 31 (R. 1. 3381)."
                    }
                  ]
                }
              ]
            },
            {
              "id_marcador_html": "— β β )",
              "id_limpio": "— β β )",
              "definicion": "Nublársele el cielo: entristecerse, acongojarse.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Quando Sancho oyó la firme resolución de su amo, se le nubló el cielo, y se le cayeron las alas del corazón.»",
                  "autor": "Cerv.",
                  "referencia_obra": "Quij. 2. 7 (Dicc. Autor.)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        }
      ]
    },
