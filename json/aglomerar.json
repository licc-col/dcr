          "definicion": "<font   face=\"arial\" color=\"#000080\"></font>",
          "ejemplos_citas": [
            {
              "texto_cita": "«Cervantes aglomeró más bien que explicó, los pretextos      con que se escudaban los malos poetas dramáticos.»",
              "autor": "<a name=\"autor1553\"><font color = \"#FF000\"><u>Clem.</u></font></b>",
              "author": "<a name=\"autor1553\"><font color = \"#FF000\"><u>Clem.</u></font></b>",
