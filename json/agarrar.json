    {
      "id": "a)",
      "definicion": "Asir fuertemente con la mano.",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "Trans.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Agarré una piedra y descalabréle.»",
              "autor": "Quev.",
              "referencia_obra": "Gran Tac. 2 (R. 23. 4872)."
            },
            {
              "marca": "",
              "texto_cita": "«Vio la grita y tabahola | Y que Oliveros agarró una tranca.»",
              "autor": "",
              "referencia_obra": "Id. Nec. de Orl. 1 (R. 69. 2911)."
            },
            {
              "marca": "",
              "texto_cita": "«Se desafierra, | Llevándose en las manos apretado | Cuanto en la dura presa había agarrado.»",
              "autor": "Erc.",
              "referencia_obra": "Arauc. 29 (R. 17. 1102)."
            },
            {
              "marca": "",
              "texto_cita": "«Agarró seis ó siete tomos que vio á sus pies, y con no vista fuerza los lanzó al enemigo.»",
              "autor": "Mor.",
              "referencia_obra": "Derr. de los pedantes (R. 2. 5702)."
            },
            {
              "marca": "",
              "texto_cita": "«Aquel niño [de Correggio] no es una divinidad; es un chiquillo como todos los demás; pero ¡qué viveza tiene! ¡qué inquietud! ¡Cómo quiere enredar con las hojas del libro de S. Jerónimo, que le presenta el ángel, mientras con la otra manecilla agarra los cabellos de la Magdalena!»",
              "autor": "",
              "referencia_obra": "Id. Obr. póst. 1, p. 322."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Con. acus de cosa (la parte asida) y dat. de pers.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Apenas la pastorcilla | Baja de su aldea al prado --- | Cuando la agarra los brazos.»",
                  "autor": "Lope",
                  "referencia_obra": ", El hijo de los leones, 2. 11 (R. 34. 2231)."
                }
              ],
              "subsubsubacepciones": []
            },
            {
              "id_marcador_html": "— β β )",
              "id_limpio": "— β β )",
              "definicion": "Con acus. de pers. ó cosa y de para expresar la parte asida.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Me agarró de la melena | Y me hizo entrar en su cárcel.»",
                  "autor": "Forner",
                  "referencia_obra": ", rom. 9 (R. 63. 3313)."
                },
                {
                  "marca": "",
                  "texto_cita": "«Agarrando [Mercurio] del pescuezo al primero que le vino á la mano, voló con él otra vez al techo.»",
                  "autor": "Mor.",
                  "referencia_obra": "Derr. de los pedantes (R. 2. 5622)."
                },
                {
                  "marca": "",
                  "texto_cita": "«Agarró de las piernas á Mercurio y le besó los pies.»",
                  "autor": "",
                  "referencia_obra": "Id. ib. (R. 2. 5631)."
                },
                {
                  "marca": "",
                  "texto_cita": "«Me agarra del brazo | Ese zafio de improviso.»",
                  "autor": "Bretón",
                  "referencia_obra": ", Los dos sobrinos, 1. 3 (1. 24)."
                },
                {
                  "marca": "",
                  "texto_cita": "«Soy hombre que tengo puños, | Y ¡pobre del que yo agarre | Del pescuezo!»",
                  "autor": "",
                  "referencia_obra": "Id. A Madrid me vuelvo, 1. 12 (1. 78)."
                }
              ],
              "subsubsubacepciones": []
            },
            {
              "id_marcador_html": "— γ γ )",
              "id_limpio": "— γ γ )",
              "definicion": "Con acus. de pers. ó cosa, y por para expresar la parte asida.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Cuál me salta á la cara, cuál me agarra | Por una pantorrilla.»",
                  "autor": "Lope",
                  "referencia_obra": ", El premio del bien hablar, 2. 1 (R. 24. 4933)."
                },
                {
                  "marca": "",
                  "texto_cita": "«Le rodean, le agarran por el freno, | Le oprimen y detienen.»",
                  "autor": "Jovell.",
                  "referencia_obra": "Poes. fáb. Los dos mulos (R. 46. 211)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        },
        {
          "id_marcador_html": "— β )",
          "id_limpio": "— β )",
          "definicion": "Absol.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Entre dos alguaciles de Toledo, | Y otra gente que agarra sin ser liga, | Nos llevan á la cárcel por ladrones.»",
              "autor": "Lope",
              "referencia_obra": ", La noche toledana, 3. 24 (R. 24. 2231)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "— γ )",
          "id_limpio": "— γ )",
          "definicion": "Intrans. Con de, para expresar la cosa cogida (ant.)",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Agarraron de cuanto había en palacio, y arrojando por las ventanas los camarines y la recámara hicieron pedazos cuantas cosas tenía de precio.»",
              "autor": "Quev.",
              "referencia_obra": "Hora de todos, 17 (R. 23.3922)."
            },
            {
              "marca": "",
              "texto_cita": "«Pidiéronle que me dejase dormir, y decía uno: Y si vuesa merced no lo cree, levanta, amigo, — y agarraba de la ropa.»",
              "autor": "",
              "referencia_obra": "Id. Gran Tac. 5 (R. 23. 4942)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        }
      ]
    },
    {
      "id": "b)",
      "definicion": "met.",
      "marca": "",
      "ejemplos_citas": [
        {
          "marca": "",
          "texto_cita": "«En su edad con tanta fuerza embiste | Las sencillas potencias el objeto, | Que ninguna un momento le resiste; | Antes agarran del primer conceto, | Y andan como los ojos de la sierva | Atendiendo a sus manos con respeto.»",
          "autor": "B. Argens.",
          "referencia_obra": "epíst. Dícesme, Nuño (R. 42. 3071)."
        }
      ],
      "subsubsubacepciones": [],
      "subacepciones": []
    },
    {
      "id": "3",
      "definicion": "A la idea de asir suelen asociarse otras:",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": []
    },
    {
      "id": "a)",
      "definicion": "Codicia ó hurto.",
      "marca": "",
      "ejemplos_citas": [
        {
          "marca": "",
          "texto_cita": "«¡Estas llaman | Bizarrías de Belisa! | ¡Cerrar puertas y ventanas | En agarrando la joya!»",
          "autor": "Lope",
          "referencia_obra": ", Las bizarrías de Belisa, 2. 15 (R. 34. 5682)."
        },
        {
          "marca": "",
          "texto_cita": "«Con esta sortija puedo | Sólo serviros ahora. | — Que no; que no me gobierno | Por interés. — i Y agarróla!»",
          "autor": "Quev.",
          "referencia_obra": "Hora de todos, 13 (R. 23. 3982)."
        },
        {
          "marca": "",
          "texto_cita": "«Entró Merlo Díaz, hecha la pretina una sarta de búcaros y vidrios, los cuales, pidiendo de beber en los tornos de las monjas, había agarrado con poco temor de Dios.»",
          "autor": "",
          "referencia_obra": "Id. Gran Tac. 16 (R. 23. 5132)."
        }
      ],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "met.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Cuando te dieren un condado, agárrale.»",
              "autor": "Cerv.",
              "referencia_obra": "Quij. 2. 50 (R. 1. 5102)."
            },
            {
              "marca": "",
              "texto_cita": "«Y Crisófilo cauto con la treta | Del volador Simón la mitra agarra.»",
              "autor": "B. Argens.",
              "referencia_obra": "epíst. Con tu licencia, Fabio (R. 42. 3132)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        }
      ]
    },
