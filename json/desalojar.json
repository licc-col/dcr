{
  "lema": "DESALOJAR.",
  "categoria_gramatical": "v.",
  "introduccion": "",
  "acepciones": [
    {
      "id": "a)",
      "definicion": "Hacer salir, echar de un lugar (trans.).",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "Con de, para expresar el lugar que se deja.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Se coligó con los madianitas sus vecinos, haciendo con ellos causa común para rechazar y desalojar de allí á los israelitas.»",
              "autor": "Scío",
              "referencia_obra": ", Núm. 22. 2, nota."
            },
            {
              "marca": "",
              "texto_cita": "«Dieron tanto cuidado sus progresos [de Barbarroja], que el emperador Carlos V no juzgó empresa indigna de su persona pasar el mar á desalojarlo de Túnez.»",
              "autor": "Clem.",
              "referencia_obra": "Coment 3, p. 161."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Part.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Las fieras, desalojadas | De sus estancias incultas, | Ya en las regiones del aire | No es mucho que se presuman | Aves.»",
                  "autor": "Cald.",
                  "referencia_obra": "auto La cena de Baltasar (2. 208)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        }
      ]
    },
    {
      "id": "b)",
      "definicion": "En especial, Obligar á una tropa enemiga á que abandone su posición (trans.).",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Se le enviaban fuerzas bastantes, con que desalojar al enemigo ó darle la batalla.»",
              "autor": "Coloma",
              "referencia_obra": ", Guerras de los Est. Bajos, 7 (R. 28. 921)."
            },
            {
              "marca": "",
              "texto_cita": "«Lo primero que se hizo fue desalojar la armada enemiga que en número de treinta bajeles guardaba el río.»",
              "autor": "",
              "referencia_obra": "Id. ib. 5 (R. 28. 571)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Part.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Nuestros escuadrones, algún poco desalojados, parece ciaban y se querían poner en huída.»",
                  "autor": "Mariana",
                  "referencia_obra": ", Hist. Esp. 11. 24 (R. 30. 3381)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        },
        {
          "id_marcador_html": "— β )",
          "id_limpio": "— β )",
          "definicion": "Con de, para expresar la posición que se abandona.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Su salud consistía en desalojar de aquel sitio al enemigo.»",
              "autor": "Melo",
              "referencia_obra": ", Guerra de Catal. 5 (R. 21. 5301)."
            },
            {
              "marca": "",
              "texto_cita": "«Fue necesaria toda la resolución de Gonzalo de Sandoval y todo el valor de su gente para desalojarlos de aquellos pasos dificultosos.»",
              "autor": "Solís",
              "referencia_obra": ", Conq. de Méj. 5. 16 (R. 28. 3682)."
            },
            {
              "marca": "",
              "texto_cita": "«Los primeros tiros de Castelnovo bastaron para desalojar al pueblo de las inmediaciones del jardín.»",
              "autor": "A. Saav.",
              "referencia_obra": "Masan. 2. 5 (5. 182)."
            },
            {
              "marca": "",
              "texto_cita": "«Pues los alemanes cargan á la bayoneta y con brío; adiós, que nos desalojan de aquel puesto.»",
              "autor": "",
              "referencia_obra": "Id. D. Álvaro, 3. 6 (4.152)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "— γ )",
          "id_limpio": "— γ )",
          "definicion": "En lenguaje científico se usa con suj. de cosa:",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Un sólido desaloja tanto del líquido en que está sumergido, un ácido á otro.»",
              "autor": "",
              "referencia_obra": ""
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        }
      ]
    },
    {
      "id": "c)",
      "definicion": "met.",
      "marca": "",
      "ejemplos_citas": [
        {
          "marca": "",
          "texto_cita": "«Ni era posible desalojar en breve tiempo de la escena á los malos autores que la habían invadido.»",
          "autor": "M. de la Rosa",
          "referencia_obra": ", Com. esp. 5 (2. 221)."
        }
      ],
      "subsubsubacepciones": [],
      "subacepciones": []
    },
    {
      "id": "d)",
      "definicion": "Dejar voluntariamente el sitio que uno ocupa ó donde mora (intrans.).",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Acordaron por estos inconvenientes de desalojar y retirarse la tierra adentro.»",
              "autor": "Mariana",
              "referencia_obra": ", Hist. Esp. 3. 18 (R. 30. 782)."
            },
            {
              "marca": "",
              "texto_cita": "«Desalojó Mauricio, y volvió á pasar el Vaal.»",
              "autor": "Coloma",
              "referencia_obra": ", Guerras de los Est. Bajos, 3 (R. 28. 272)."
            },
            {
              "marca": "",
              "texto_cita": "«Detúvose el duque lo que bastó para dejar en defensa dos fuertes que se hicieron --- Y al fin desalojó el campo á los 12 de noviembre.»",
              "autor": "",
              "referencia_obra": "Id. ib. 1 (R. 28. 111)."
            },
            {
              "marca": "",
              "texto_cita": "«Se echó de ver que el enemigo desalojaba para mejorar de puesto.»",
              "autor": "",
              "referencia_obra": "Id. ib. 5 (R. 28. 581)."
            },
            {
              "marca": "",
              "texto_cita": "«No ponía duda en que el enemigo había desalojado.»",
              "autor": "",
              "referencia_obra": "Id. ib. 5 (R. 28. 551)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "— β )",
          "id_limpio": "— β )",
          "definicion": "Con de.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Nuestro campo había desalojado de Ujíjar con pérdida y desorden.»",
              "autor": "Mend.",
              "referencia_obra": "Guerra de Gran. 4 (R. 21. 1151)."
            },
            {
              "marca": "",
              "texto_cita": "«Desalojó [el duque de Parma] de Juetoy la noche de los 18 de mayo.»",
              "autor": "Coloma",
              "referencia_obra": ", Guerras de los Est. Bajos, 5 (R. 28. 591)."
            },
            {
              "marca": "",
              "texto_cita": "«Al desalojar don Agustín del país de Cambray, le pareció sitiar el castillo de Huesi.»",
              "autor": "",
              "referencia_obra": "Id. ib. 7 (R. 28. 991)."
            },
            {
              "marca": "",
              "texto_cita": "«Si Honoria se empeña | En que de aquí desaloje, | Prometedme interceder | Para que el fallo revoque.»",
              "autor": "Hartz.",
              "referencia_obra": "Honoria, 2. 10 (232)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        }
