{
  "lema": "DESCABALAR.",
  "categoria_gramatical": "v.",
  "introduccion": "",
  "acepciones": [
    {
      "id": "a)",
      "definicion": "Dejar incompleto ó manco, quitando ó haciendo perder algo de lo que constituye la cosa cabal completa (trans.).",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Desde que os vi á la ventana, | U dando ó tomando el sol | Descabalé mi asadura | Por daros el corazón.»",
              "autor": "Quev.",
              "referencia_obra": "Musa 6, rom. 33 (R. 69. 1781)."
            },
            {
              "marca": "",
              "texto_cita": "«Junta los cobardes el poder, y descabálalos el miedo.»",
              "autor": "",
              "referencia_obra": "Id. Polít. de Dios, 2. 22 (R. 23. 982)."
            },
            {
              "marca": "",
              "texto_cita": "«Y rio porque excluyamos la fénix ave, descabalaremos el hermoso argumento de Tertuliano, referido arriba, para probar la resurrección de la carne.»",
              "autor": "",
              "referencia_obra": "Id. Job (R. 48. 2412)."
            },
            {
              "marca": "",
              "texto_cita": "«Pues si no hay prenda, no hay nada. | Mas de plata una salvilla | Hace poco que oí nombrar. | — ¿Y hemos de descabalar, | Don Simeón, la vajilla? | — ¿Descabalar? ¡buena es ésa! | Toda la he de recibir.»",
              "autor": "",
              "referencia_obra": "A. Saav, Tanto vales cuanto tienes, 1. 19 (4. 37)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Part.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Descabalado queda el texto para los que osaren valerse de su aplicación.»",
                  "autor": "Quev.",
                  "referencia_obra": "Polític. de Dios, 2. 9 (R. 23. 602)."
                },
                {
                  "marca": "",
                  "texto_cita": "«Por otra parte asomó con pies descabalados Saturno, el dios marimanta.»",
                  "autor": "",
                  "referencia_obra": "Id. Hora de todos, preámb. (R. 23. 3841)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        }
      ]
    },
