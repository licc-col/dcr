      "definicion": "En especial aplicado a la persona cuyo trato o modo de ser no es agradable.",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "X",
              "texto_cita": "«Un Tomé Santos bobo, y un bachiller Valentín, personajes inútiles y pegadizos, son insoportables.»",
              "autor": "Mor.",
              "referencia_obra": "Obr. (Acad. Hist. 1. 207)."
            },
            {
              "marca": "X",
              "texto_cita": "«El grito de protesta se perdería en el valle, acrecentando el griterío de las lágrimas de los guaguas y de la mujer, de suyo ya insoportable.»",
              "autor": "Icaza",
              "referencia_obra": ", Huasipungo, p. 123."
            },
            {
              "marca": "X",
              "texto_cita": "«María se había ruborizado intensamente. Qué muchacha insoportable es Julia, le dijo aquella noche.»",
              "autor": "Mendoza",
              "referencia_obra": ", Años de fuga, 1. 3 (p. 59)."
            }
          ],
          "subsubsubacepciones": [
            {
              "id_limpio": "—",
