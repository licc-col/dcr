      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "Con dat. Además con sobre.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "X",
              "texto_cita": "«Zumbábanle, pues, sobre la facilidad con que los españoles de cualquier condición y clase toman el tratamiento de Don.»",
              "autor": "Cadalso",
              "referencia_obra": ", Cartas marr. 80 (2. 325; R. 13. 6391)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
