          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "X",
              "texto_cita": "«¡Florencia! —exclamó Daniel, con voz irritada— aquí hay una injusticia horrible, y yo exijo una explicación ahora mismo.»",
              "autor": "Mármol",
              "referencia_obra": ", Amalia, 1 (p. 128)."
            },
            {
              "marca": "X",
              "texto_cita": "«Cuando lleguen los bárbaros | A las puertas de oro | De tu ciudad, alzando | Con irritada mano | Las estridentes picas, | Déjalos que penetren | Y huellen con el casco | De sus corceles ágiles.»",
              "autor": "Maya",
              "referencia_obra": ", Obra poét. 1 (p. 57)."
            }
