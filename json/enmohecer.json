          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Planchas fuertes hechas con la mezcla del cobre y el estaño, que de ninguna suerte se enmohecen.»",
              "autor": "M. G. Suárez",
              "referencia_obra": ", Trad. Arte Papel de La Lande, p. 40."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
