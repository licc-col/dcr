              "texto_cita": "«Desprevenido de   todo.»",
              "autor": "<a name=\"autor1847\"><font color = \"#FF000\"><u>Salvá</u></font></b>",
              "author": "<a name=\"autor1847\"><font color = \"#FF000\"><u>Salvá</u></font></b>",
              "referencia_obra": ", <i>Gram.</i> </font><font face=\"arial\"   color=\"#000080\">"
            },
            {
