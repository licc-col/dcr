{
  "lema": "ATÓNITO, A.",
  "categoria_gramatical": "adj.",
  "introduccion": "--><dicabrev><a name=\"abrev294\"><b><u>adj.</u></b></dicabrev></i></font><font   face=\"arial\" color=\"#0000ff\"> </p>   </font><font face=\"arial\"><p ALIGN=\"JUSTIFY\">Pasmado ó espantado de algún objeto ó de   algún suceso.",
  "acepciones": [
    {
      "id": "",
      "definicion": "",
      "ejemplos_citas": [],
      "subacepciones": [
        {
          "id_marcador_html": "</p>   <p ALIGN=\"JUSTIFY\">— </font><font face=\"symbol\">α</font><font face=\"arial\"> )",
          "id_limpio": "— α )",
          "definicion": "<i>Absol.   </i></font><font face=\"arial\" color=\"#000080\">",
          "ejemplos_citas": [
            {
              "texto_cita": "«A todo esto ella no respondía palabra,   atónita y confusa.»",
              "autor": "<a name=\"autor295\"><font color = \"#FF000\"><u>Cerv.</u></font></b>",
              "author": "<a name=\"autor295\"><font color = \"#FF000\"><u>Cerv.</u></font></b>",
              "referencia_obra": "<i> Quij.</i> 1. 28 (R. 1. 325<sup>1</sup>).   </font><font face=\"arial\" color=\"#000080\">"
            },
            {
              "texto_cita": "«Yo quedé suspenso, Anselmo atónito, el padre   triste, sus parientes afrentados, solícita la justicia, los cuadrilleros listos.»",
              "autor": "",
              "author": "",
              "referencia_obra": "</font><font   face=\"arial\"> Id.<i> ib</i>. 1. 51 (R. 1. 397<sup>1</sup>). </font><font face=\"arial\"   color=\"#000080\">"
            },
            {
              "texto_cita": "«La verdad que diga, respondió Sancho, las desaforadas narices de aquel   escudero me tienen atónito y lleno de espanto.»",
              "autor": "",
              "author": "",
              "referencia_obra": "</font><font face=\"arial\"> Id.<i> ib. </i>2.   14 (R. 1. 432<sup>2</sup>). </font><font face=\"arial\" color=\"#000080\">"
            },
            {
              "texto_cita": "«Díme quién eres,   que me tienes atónito.»",
              "autor": "",
              "author": "",
              "referencia_obra": "</font><font face=\"arial\"> Id.<i> ib.</i> 2. 55 (R. 1. 521<sup>1</sup>).   </font><font face=\"arial\" color=\"#000080\">"
            },
            {
              "texto_cita": "«Oyendo lo cual todos quedaron atónitos, y   más viendo que en todo el aposento ni al derredor de la mesa no había persona humana que   responder pudiese.»",
              "autor": "",
              "author": "",
              "referencia_obra": "</font><font face=\"arial\"> Id. <i>ib</i>. 2. 63 (R. 1. 536<sup>2</sup>).   </font><font face=\"arial\" color=\"#000080\">"
            },
            {
              "texto_cita": "«Oyendo hablar cosas tan altas á los   apóstoles, cada uno en su lengua, quedaron atónitos, y como fuera de sí.»",
              "autor": "<a name=\"autor296\"><font color = \"#FF000\"><u>Rivad.</u></font></b>",
              "author": "<a name=\"autor296\"><font color = \"#FF000\"><u>Rivad.</u></font></b>",
              "referencia_obra": "<i>Flos SS. Pentecostés (Vida de Cristo, </i>302). </font><font   face=\"arial\" color=\"#000080\">"
            },
            {
              "texto_cita": "«Distraían de sus miserias al pueblo, que admiraba atónito   las galas, la riqueza, el buen gusto, la bizarría y el valor de los que tan mal le   gobernaban.»",
              "autor": "<a name=\"autor297\"><font color = \"#FF000\"><u>Mor.</u></font></b>",
              "author": "<a name=\"autor297\"><font color = \"#FF000\"><u>Mor.</u></font></b>",
              "referencia_obra": "<i>Oríg. disc. hist. </i>(R. 2. 156)."
            }
          ],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "</p>   <p ALIGN=\"JUSTIFY\">— </font><font face=\"symbol\">β</font><font face=\"arial\"> )",
          "id_limpio": "— β )",
          "definicion": "Con <i>de</i>,   para expresar el origen del espanto ó pasmo. </font><font face=\"arial\" color=\"#000080\">",
          "ejemplos_citas": [
            {
              "texto_cita": "«Quedó   suspenso y atónito de su hermosura, y no acertó á preguntarle nada.»",
              "autor": "<a name=\"autor298\"><font color = \"#FF000\"><u>Cerv.</u></font></b>",
              "author": "<a name=\"autor298\"><font color = \"#FF000\"><u>Cerv.</u></font></b>",
              "referencia_obra": "<i>Nov</i>. 8 (R. 1. 185<sup>2</sup>). </font><font face=\"arial\"   color=\"#000080\">"
            },
            {
              "texto_cita": "«Estaban Leonela y Lotario suspensos y atónitos de tal suceso, y   todavía dudaban de la verdad de aquel hecho.»",
              "autor": "",
              "author": "",
              "referencia_obra": "</font><font face=\"arial\"> Id.<i> Quij.</i>   1. 34 (R. 1. 351<sup>1</sup>). </font><font face=\"arial\" color=\"#000080\">"
            },
            {
              "texto_cita": "«Quedaron tan   pasmados y atónitos del hecho, que no pudieron tomar resolución.»",
              "autor": "<a name=\"autor299\"><font color = \"#FF000\"><u>Moncada</u></font></b>",
              "author": "<a name=\"autor299\"><font color = \"#FF000\"><u>Moncada</u></font></b>",
              "referencia_obra": ", <i>Exped</i>. 59 (R. 21. 55<sup>2</sup>)."
            }
          ],
          "subsubacepciones": [
            {
              "id_marcador_html": "</p>   <p ALIGN=\"JUSTIFY\">— </font><font face=\"symbol\">α</font><font face=\"arial\"> </font><font face=\"symbol\">α</font><font face=\"arial\"> )",
              "id_limpio": "— α α )",
              "definicion": "Con un <dicabrev><a name=\"abrev300\"><b><u>infin.</u></b></dicabrev> </font><font face=\"arial\"   color=\"#000080\">",
              "ejemplos_citas": [
                {
                  "texto_cita": "«A todo estaba presente Sancho, embobado y atónito de ver la honra que   á su señor aquellos príncipes le hacían.»",
                  "autor": "<a name=\"autor301\"><font color = \"#FF000\"><u>Cerv.</u></font></b>",
                  "author": "<a name=\"autor301\"><font color = \"#FF000\"><u>Cerv.</u></font></b>",
                  "referencia_obra": "<i> Quij.</i>   2. 31 (R. 1. 470<sup>1</sup>). </font><font face=\"arial\" color=\"#000080\">"
                },
                {
                  "texto_cita": "«Mirando á   todas partes quedaron atónitos de verse en el mismo jardín de donde habían partido.»",
                  "autor": "",
                  "author": "",
                  "referencia_obra": "</font><font   face=\"arial\"> Id.<i> ib.</i> 2. 41 (R. 1. 490<sup>1</sup>). </font><font face=\"arial\"   color=\"#000080\">"
                },
                {
                  "texto_cita": "«Cuando pone los ojos en el misterio de nuestra redención, queda como   atónito de ver cómo aquella altísima y incomprensible majestad quiso vestirse de   nuestra carne.»",
                  "autor": "<a name=\"autor302\"><font color = \"#FF000\"><u>Gran.</u></font></b>",
                  "author": "<a name=\"autor302\"><font color = \"#FF000\"><u>Gran.</u></font></b>",
                  "referencia_obra": "<i>Símb.</i> 2. 32, § 2 (R. 6. 392<sup>2</sup>).   </font><font face=\"arial\" color=\"#000080\">"
                },
                {
                  "texto_cita": "«Quedaron atónitos los indios de ver posible   aquel destrozo.»",
                  "autor": "<a name=\"autor303\"><font color = \"#FF000\"><u>Solís</u></font></b>",
                  "author": "<a name=\"autor303\"><font color = \"#FF000\"><u>Solís</u></font></b>",
                  "referencia_obra": ", <i>Conq. de Méj. </i>1. 15 (R. 28.   223<sup>2</sup>)."
                }
              ]
            }
          ]
        },
        {
          "id_marcador_html": "</p>   <p ALIGN=\"JUSTIFY\">— </font><font face=\"symbol\">β</font><font face=\"arial\"> )",
          "id_limpio": "— β )",
          "definicion": "Con una   <dicabrev><a name=\"abrev304\"><b><u>prop. subj.</u></b></dicabrev> </font><font face=\"arial\" color=\"#000080\">",
          "ejemplos_citas": [
            {
              "texto_cita": "«¿Quién es ese tío Gregorio?   preguntéle, atónito de que aprobase tal insolencia.»",
              "autor": "<a name=\"autor305\"><font color = \"#FF000\"><u>Cadalso</u></font></b>",
              "author": "<a name=\"autor305\"><font color = \"#FF000\"><u>Cadalso</u></font></b>",
              "referencia_obra": ",   <i>Cart. marr</i>. 7 (2. 57)."
            }
          ],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "</p>   <p ALIGN=\"JUSTIFY\">— </font><font face=\"symbol\">γ</font><font face=\"arial\"> )",
          "id_limpio": "— γ )",
          "definicion": "Con <i>con</i>,   en sentido análogo. </font><font face=\"arial\" color=\"#000080\">",
          "ejemplos_citas": [
            {
              "texto_cita": "«Quedaron los enemigos   atónitos con tan gran milagro.»",
              "autor": "<a name=\"autor306\"><font color = \"#FF000\"><u>Mariana</u></font></b>",
              "author": "<a name=\"autor306\"><font color = \"#FF000\"><u>Mariana</u></font></b>",
              "referencia_obra": ", <i>Hist. Esp</i>. 7. 2   (R. 30. 192<sup>1</sup>)."
            }
          ],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "</p>   <p ALIGN=\"JUSTIFY\">— </font><font face=\"symbol\">δ</font><font face=\"arial\"> )",
          "id_limpio": "— δ )",
          "definicion": "Con <i>por</i>,   en sentido análogo. </font><font face=\"arial\" color=\"#000080\">",
          "ejemplos_citas": [
            {
              "texto_cita": "«Atónito por la   desgracia.»",
              "autor": "<a name=\"autor307\"><font color = \"#FF000\"><u>Acad.</u></font></b>",
              "author": "<a name=\"autor307\"><font color = \"#FF000\"><u>Acad.</u></font></b>",
              "referencia_obra": "<i>Gram</i>. </font><font face=\"arial\"   color=\"#000080\">"
            },
            {
              "texto_cita": "«Atónito por el suceso.»",
              "autor": "<a name=\"autor308\"><font color = \"#FF000\"><u>Salvá</u></font></b>",
              "author": "<a name=\"autor308\"><font color = \"#FF000\"><u>Salvá</u></font></b>",
              "referencia_obra": ", <i>Gram</i>."
            }
          ],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "</p>   <p ALIGN=\"JUSTIFY\">— </font><font face=\"symbol\">ε</font><font face=\"arial\"> )",
          "id_limpio": "— ε )",
          "definicion": "También se expresa la causa ú ocasión del pasmo con un gerundio. </font><font   face=\"arial\" color=\"#000080\">",
          "ejemplos_citas": [
            {
              "texto_cita": "«Las labradoras estaban asimismo atónitas viendo aquellos   dos hombres tan diferentes hincados de rodillas, que no dejaban pasar adelante á su   compañera.»",
              "autor": "<a name=\"autor309\"><font color = \"#FF000\"><u>Cerv.</u></font></b>",
              "author": "<a name=\"autor309\"><font color = \"#FF000\"><u>Cerv.</u></font></b>",
              "referencia_obra": "<i> Quij.</i> 2. 10 (R.1. 424<sup>1</sup>). </font><font   face=\"arial\" color=\"#000080\">"
            },
            {
              "texto_cita": "«¿Quién no quedará atónito considerando la grandeza de   aquel poder, y de aquella sabiduría y providencia que tantas y tan grandes maravillas   obró en tantas diferencias de criaturas, y lo que más es, con una sola palabra?»",
              "autor": "",
              "author": "",
              "referencia_obra": "</font><font   face=\"arial\"> Gran<i>. Símb.</i> 1. 11 (R. 6. 211<sup>1</sup>). </font><font face=\"arial\"   color=\"#000080\">"
            },
            {
              "texto_cita": "«Quedaron todos atónitos, notando la novedad y el rigor del castigo.»",
              "autor": "<a name=\"autor310\"><font color = \"#FF000\"><u>Solís</u></font></b>",
              "author": "<a name=\"autor310\"><font color = \"#FF000\"><u>Solís</u></font></b>",
              "referencia_obra": ", <i>Conq. de Méj. </i>2. 20 (R. 28. 261<sup>1</sup>).</p>   </font><b><font face=\"arial\" color=\"#800080\"><p ALIGN=\"JUSTIFY\"></b>"
            }
          ],
          "subsubacepciones": []
        }
      ]
    }
  ],
  "periodo_anteclasico": "<dicarbrecont><a name=\"arbre312\"><dicabrev><a name=\"abrev311\"><b><u>Per. antecl.</u></b></dicabrev></dicarbrecont></font><font   face=\"arial\" color=\"#0000ff\"> </font></b><font face=\"arial\">— <i>Siglo XV:</i> </font><font   face=\"arial\" color=\"#000080\">«Todos eran atónitos del ruido.»</font><font face=\"arial\">   <i><dicautor><a name=\"autor313\"><font color = \"#FF000\"><u>Crón. M. Lucas</u></font></b></dicautor></i> (<i>Mem. hist. esp</i>. 8. 52).</p>   </font><b><font face=\"arial\" color=\"#800080\">",
  "testimonios_latino_hispanicos": "",
  "etimologia": "<dicarbrecont><a name=\"arbre314\">Etim.</dicarbrecont></font><font   face=\"arial\" color=\"#0000ff\"> </font></b><font face=\"arial\">Lat. <i>attonitus</i>, herido   por un rayo, que ha visto caer cerca un rayo, <dicabrev><a name=\"abrev315\"><b><u>part.</u></b></dicabrev> de <i>attonare</i>, <dicabrev><a name=\"abrev316\"><b><u>comp.</u></b></dicabrev> de <i>tonare,   </i>tronar.</p>   <p ALIGN=\"JUSTIFY\"> </p>   <p ALIGN=\"JUSTIFY\"> </p>   </font><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br></body></html>\u0000</b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b>",
