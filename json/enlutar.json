    {
      "id": "a)",
      "definicion": "Oscurecer, quitar la luz (trans.).",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "RAE",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Del mar bravoso sube, | Enlutando los orbes, noche umbría.»",
              "autor": "Lista",
              "referencia_obra": ", Poes. (R. 67. 2892). RAE"
            },
            {
              "marca": "",
              "texto_cita": "«Y notando que el sol su lumbre pura | En los mares de Ocaso sumergía, | Enlutando los montes y llanura | Y dando paso a la tiniebla fría ---»",
              "autor": "A. Saav.",
              "referencia_obra": "Obr. complet. (ed. 1854, t. 1, p. 46). RAE"
            },
            {
              "marca": "",
              "texto_cita": "«Así, cuando una nube repentina | Enluta el cielo, cuando el sol declina, | Se afanan los pastores recogiendo.»",
              "autor": "Olmedo",
              "referencia_obra": "(en Antol. poet. americ. ed. Acad. t. 3, p. 301)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Con la prep. con, para indicar el instrumento. RAE",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«¿No habéis visto nube descomedida que, opuesta al sol, muestra ceñudo el día, y enluta con sombras las cumbres?»",
                  "autor": "Quev.",
                  "referencia_obra": "Obras, (ed. Astrana Marín, 1932, t. 1, p. 883)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        },
        {
          "id_marcador_html": "— β )",
          "id_limpio": "— β )",
          "definicion": "Refl. Con sentido intrans. RAE",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Que cuando el tiempo se enluta | Me dan el níspero en paja.»",
              "autor": "Lope",
              "referencia_obra": ", Com. (R. 4. 1913). RAE"
            },
            {
              "marca": "",
              "texto_cita": "«Ahora que la Sierra se ha enlutado, | Que el sol, planeta ardiente, se ha mareado | En los golfos mayores ---»",
              "autor": "Rojas",
              "referencia_obra": ", Com. (R. 54. 4122). RAE"
            },
            {
              "marca": "",
              "texto_cita": "«Quando las sombras lúgubres, | Por las exequias del Sol, | Hazen que el ayre se enlute ---.»",
              "autor": "Cald.",
              "referencia_obra": "Com. 9ª pte. (ed. Bera Tassis, p. 39)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Con entre.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Antes de la hora en que el sol sanguíneo empenacha las lejanías, fueles imperioso encender la hoguera, porque entre los bosques la tarde se enluta.»",
                  "autor": "Rivera",
                  "referencia_obra": ", La vorágine, 3 (p. 194)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        },
        {
          "id_marcador_html": "— γ )",
          "id_limpio": "— γ )",
          "definicion": "Part. RAE",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Monarcas festivos que lucían sus medallones de oro sobre el paño negro de la noche, carrozas de luz en carrera hacia los astros enlutados de la noche.»",
              "autor": "Fuentes",
              "referencia_obra": ", Muerte Artemio (ed. 1968, p. 258)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        }
