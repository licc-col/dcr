  "acepciones": [
    {
      "id": "a)",
      "definicion": "Sujetar, poner á tarea (trans.).",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "Con á, para denotar el objeto en que consiste la tarea.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«El alhelí, jazmines y claveles | Por cuadros, laberintos y planteles | Me construían macetas, | Que entre azahares ataba, | Con que el ocio al deleite atareaba, | Sin reparar entonces mis pesares, | Que pocas letras hay de azar á azahares.»",
              "autor": "Tirso",
              "referencia_obra": ", En Madrid y en una casa, 2. 5 (R. 5. 5452)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Part.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«He tenido muchos años atareado mi corto entendimiento á la inteligencia de este lugar.»",
                  "autor": "Quev.",
                  "referencia_obra": "Polític. de Dios, 2. 21 (R. 23. 952)."
                },
                {
                  "marca": "",
                  "texto_cita": "«¡Gran servidumbre padece el entendimiento atareado á responder á solo aquello que le quisieren preguntar!»",
                  "autor": "",
                  "referencia_obra": "Id. ib. 1. 12 (R. 23. 251)."
                },
                {
                  "marca": "",
                  "texto_cita": "«Estas criaturas en cuya grandeza parece que se desalienta la admiración, y queda absorto el espanto, se confiesan atareadas á superior voluntad.»",
                  "autor": "",
                  "referencia_obra": "Id. Provid. de Dios (R. 48. 1941)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        }
      ]
    },
    {
      "id": "b)",
      "definicion": "Refl. Entregarse mucho al trabajo.",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Para separar lo verdadero de lo falso he ideado esta obra, para esto me atareo, para esto trabajo.»",
              "autor": "",
              "referencia_obra": "Esp, sagr. 4, pról."
            },
            {
              "marca": "",
              "texto_cita": "«Esto me hace temer que usted se afane y ataree mucho más de lo que conviniera á una constitución delicada como la suya.»",
              "autor": "Jovell.",
              "referencia_obra": "Corresp. con Trigueros (R. 50. 1651)."
            },
            {
              "marca": "",
              "texto_cita": "«Quiero que viva y restablezca su salud; que se pasee, y lea, y se ataree poco, y pase las horas en compañía de sus amigos.»",
              "autor": "Mor.",
              "referencia_obra": "Obr. póst. 3, p. 118."
            },
            {
              "marca": "",
              "texto_cita": "«No desaprovecharon los sitiados aquel respiro, y atareándose afanadamente, aumentaron los fuegos de flanco y parabólicos.»",
              "autor": "Toreno",
              "referencia_obra": ", Hist.10 (R. 64. 2192)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Part.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Vivió siempre atareado [el maestro Alejo Venegas] para sostener una numerosa familia.»",
                  "autor": "Gil y Zárate",
                  "referencia_obra": ", Resum. histór. p. 503."
                }
              ],
              "subsubsubacepciones": []
            },
            {
              "id_marcador_html": "— β β )",
              "id_limpio": "— β β )",
              "definicion": "Part. Por extensión.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Es el tiempo más enfadoso, más engorroso y más neciamente atareado de todo el año.»",
                  "autor": "Isla",
                  "referencia_obra": ", Cart. famil. 1. 45 (R. 15. 4422)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        },
        {
          "id_marcador_html": "— β )",
          "id_limpio": "— β )",
