      "marca": "",
      "ejemplos_citas": [
        {
          "marca": "",
          "texto_cita": "«Y como el milano suele, | En agarrando los pollos | Volar por el aire leve, Parten al castillo.»",
          "autor": "Lope",
          "referencia_obra": ", Lo que ha de ser, 2. 11 (R. 34. 5161)."
        }
      ],
      "subsubsubacepciones": [],
      "subacepciones": []
