      "ejemplos_citas": [
        {
          "texto_cita": "«Del ganado   derreniego, </font><font face=\"symbol\">|</font><font face=\"arial\"   color=\"#000080\"> E aun de quien guarda tal hato.»",
          "autor": "<a name=\"autor795\"><font color = \"#FF000\"><u>Encina</u></font></b>",
          "author": "<a name=\"autor795\"><font color = \"#FF000\"><u>Encina</u></font></b>",
          "referencia_obra": ", <i>egl.</i>   1. (R. 2. 231</font><sup>3</sup><font face=\"arial\">). </font><font face=\"arial\"   color=\"#000080\">"
        },
        {
          "texto_cita": "«Quita esos hatos, Pascuala, </font><font face=\"symbol\">|</font><font   face=\"arial\" color=\"#000080\"> E dellos ya derreniega.»",
          "autor": "",
          "author": "",
          "referencia_obra": "</font><font face=\"arial\"> Id. (<i>Ens</i>.   <i>bibl. esp</i>. 2. 912). </font><font face=\"arial\" color=\"#000080\">"
        },
        {
          "texto_cita": "«Derreniego   del amor.»",
          "autor": "<a name=\"autor796\"><font color = \"#FF000\"><u>Fernández</u></font></b>",
          "author": "<a name=\"autor796\"><font color = \"#FF000\"><u>Fernández</u></font></b>",
          "referencia_obra": ", p. 3. </font><font face=\"arial\"   color=\"#000080\">"
        },
        {
          "texto_cita": "«Derrenegad siempre de unos hombres como unos perales, enjutos, magros,   altos y desvaídos.»",
          "autor": "<a name=\"autor797\"><font color = \"#FF000\"><u>Alemán</u></font></b>",
          "author": "<a name=\"autor797\"><font color = \"#FF000\"><u>Alemán</u></font></b>",
          "referencia_obra": ", <i>Guzmán</i>, 2. 2. 7 (R. 3.   307</font><sup>2</sup><font face=\"arial\">). </font><font face=\"arial\" color=\"#000080\">"
        },
        {
          "texto_cita": "«Derreñeguen   de un fallo destos á carga cerrada.»",
          "autor": "",
          "author": "",
          "referencia_obra": "</font><font face=\"arial\"> Ib. <i>ib</i>. 2. 2. 3   (R. 3. 293</font><sup>2</sup><font face=\"arial\">).</p>   </font><font face=\"arial\" color=\"#800080\"><b></b>"
        }
      ],
