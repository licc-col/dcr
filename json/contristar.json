{
  "lema": "CONTRISTAR.",
  "categoria_gramatical": "v.",
  "introduccion": "--><dicabrev><a name=\"abrev1229\"><b><u>v.</u></b></dicabrev></i>      </font></p>   <font face=\"arial\">    <p ALIGN=\"JUSTIFY\">Causar mucha tristeza, llenar de tristeza (<i>trans</i>.).",
  "acepciones": [
    {
      "id": "",
      "definicion": "",
      "ejemplos_citas": [],
      "subacepciones": [
        {
          "id_marcador_html": "</p>   </font>    <p ALIGN=\"JUSTIFY\"><font face=\"arial\">— </font><font face=\"symbol\">α</font><font face=\"arial\">      ) </font>",
          "id_limpio": "— α )",
          "definicion": "<font   face=\"arial\" color=\"#000080\"></font>",
          "ejemplos_citas": [
            {
              "texto_cita": "«El le reprendió con severidad, dejándole sin otro      castigo, porque no se hallaba en tiempo de contristar a gente con la demostración      que merecía.»",
              "autor": "<a name=\"autor1230\"><font color = \"#FF000\"><u>Solís</u></font></b>",
              "author": "<a name=\"autor1230\"><font color = \"#FF000\"><u>Solís</u></font></b>",
              "referencia_obra": ", <i>Conq. de Méj.</i> 5. 23      (R. 28. 382<sup>1</sup>). </font><font face=\"arial\" color=\"#000080\">"
            },
            {
              "texto_cita": "«Desorden      que por ser de todo punto contrario á los cánones, y que las orejas católicas      no lo sufren, tanto más nos ha contristado cuanto es mayor la afición que      te tenemos.»",
              "autor": "<a name=\"autor1231\"><font color = \"#FF000\"><u>Mariana</u></font></b>",
              "author": "<a name=\"autor1231\"><font color = \"#FF000\"><u>Mariana</u></font></b>",
              "referencia_obra": ", <i>Hist. Esp.</i> 10. 6 (R.      30. 284<sup>2</sup>). </font><font face=\"arial\" color=\"#000080\">"
            },
            {
              "texto_cita": "«El actual      abandono me contrista | De las dormidas musas castellanas.»",
              "autor": "<a name=\"autor1232\"><font color = \"#FF000\"><u>T. Iriarte</u></font></b>",
              "author": "<a name=\"autor1232\"><font color = \"#FF000\"><u>T. Iriarte</u></font></b>",
              "referencia_obra": ", <i>epíst.</i> 4 (R. 63. 29<sup>1</sup>). </font><font face=\"arial\"   color=\"#000080\">"
            },
            {
              "texto_cita": "«Aquel héroe que adversidad ninguna, ningún trabajo pudo contristar,      se vio vencido por este contratiempo.»",
              "autor": "<a name=\"autor1233\"><font color = \"#FF000\"><u>Quint.</u></font></b>",
              "author": "<a name=\"autor1233\"><font color = \"#FF000\"><u>Quint.</u></font></b>",
              "referencia_obra": "<i>Gran      Capitán</i> (R. 19. 278<sup>1</sup>). </font><font face=\"arial\" color=\"#000080\">"
            },
            {
              "texto_cita": "«Que      le contrista en el alma | Tan dura resolución.»",
              "autor": "",
              "author": "",
              "referencia_obra": "</font><font face=\"arial\">      Bartz. <i>Primero yo,</i> 2. 2 (98)."
            }
          ],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "</font></p>   <p ALIGN=\"JUSTIFY\"> <font face=\"arial\">— </font><font face=\"symbol\">β</font><font face=\"arial\">      )",
          "id_limpio": "— β )",
          "definicion": "<i>Refl</i>. </font><font face=\"arial\" color=\"#000080\">",
          "ejemplos_citas": [
            {
              "texto_cita": "«Su corazón se contristó      profundamente ante la idea de los infelices que se perdían por sus errores.»",
              "autor": "<a name=\"autor1234\"><font color = \"#FF000\"><u>Ochoa</u></font></b>",
              "author": "<a name=\"autor1234\"><font color = \"#FF000\"><u>Ochoa</u></font></b>",
              "referencia_obra": "(<i>Míst</i>. 1. IX)."
            }
          ],
          "subsubacepciones": [
            {
              "id_marcador_html": "</font></p>   <p ALIGN=\"JUSTIFY\"> <font face=\"arial\">— </font><font face=\"symbol\">α</font><font face=\"arial\">      </font><font face=\"symbol\">α</font><font face=\"arial\"> )",
              "id_limpio": "— α α )",
              "definicion": "Como en otros verbos significativos      de afectos del ánimo, la causa que los produce se puede señalar con <i>de</i>,      <i>con</i> ó <i>por.</i> </font><font face=\"arial\" color=\"#000080\">",
              "ejemplos_citas": [
                {
                  "texto_cita": "«Volvióse      á contristar Motezuma de que saliese con fuerzas tan desiguales.»",
                  "autor": "<a name=\"autor1235\"><font color = \"#FF000\"><u>Solís</u></font></b>",
                  "author": "<a name=\"autor1235\"><font color = \"#FF000\"><u>Solís</u></font></b>",
                  "referencia_obra": ", <i>Conq. de Méj.</i> 4. 7 (R. 28. 314<sup>1</sup>). </font><font face=\"arial\" color=\"#000080\">"
                },
                {
                  "texto_cita": "«Ellos      se contristaron de manera con esta proposición, que sólo respondían con el      llanto y el gemido.»",
                  "autor": "",
                  "author": "",
                  "referencia_obra": "</font><font face=\"arial\"> Id. <i>ib</i>. 2. 12 (R. 28.      248<sup>1</sup>).</font></p>   <p ALIGN=\"JUSTIFY\"><font face=\"arial\" color=\"#800080\"><b></b>"
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "etimologia": "<dicarbrecont><a name=\"arbre1237\"><dicabrev><a name=\"abrev1236\"><b><u>Per. antecl.</u></b></dicabrev></dicarbrecont></b></font><font   face=\"arial\"> <i>Siglo XV:</i> </font><font face=\"arial\" color=\"#000080\">«Mas      si por caso se fueren, | Nos vos deueys contristar.»</font><font face=\"arial\">      <i>Canc. de G. Manr.</i> 1, p. 332. </font></p>   <p ALIGN=\"JUSTIFY\"> <font face=\"arial\">— <i>Siglo XIII</i>: </font><font face=\"arial\" color=\"#000080\">«Y      en la muerte non fue contristado con miedo de sus enimigos.»</font><font face=\"arial\">      <i><dicautor><a name=\"autor1238\"><font color = \"#FF000\"><u>Fuero</u></font></b></dicautor> Juzgo,</i> 4. 2. 14 (70). </font><font face=\"arial\" color=\"#000080\">«Fiziestes      lo llorrar, auedes lo contristado.»</font><font face=\"arial\"> <i>Appoll</i>.      177</font><font   face=\"arial\" color=\"#0000ff\"> </font><font face=\"arial\">(R. 57. 289<sup>1</sup>).</font></p>   <p ALIGN=\"JUSTIFY\"><b><font face=\"arial\" color=\"#800080\"><dicarbrecont><a name=\"arbre1239\">Etim.</dicarbrecont></font><font   face=\"arial\" color=\"#0000ff\"> </font></b><font face=\"arial\">Port., cat., <dicabrev><a name=\"abrev1240\"><b><u>prov.</u></b></dicabrev>      <i>contristar</i>; <dicabrev><a name=\"abrev1241\"><b><u>fr.</u></b></dicabrev> <i>contrister</i>; <dicabrev><a name=\"abrev1242\"><b><u>it.</u></b></dicabrev> <i>contristare</i>: del <dicabrev><a name=\"abrev1243\"><b><u>lat.</u></b></dicabrev>      <i>contristare</i>, compuesto de <i>cum,</i> con, intensivo, y <i>tristis</i>,      triste.</font></p>   <font face=\"arial\" color=\"#0000ff\"><b>    <p ALIGN=\"JUSTIFY\"> </p>   <p ALIGN=\"JUSTIFY\"> </p>   </b></font><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br><br></body></html>\u0000</b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b></b>"
}