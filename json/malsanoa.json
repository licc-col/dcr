          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "X",
              "texto_cita": "«¿Eres tú?... Debes de ser | Porque del ser de mujer | Se espera mayor flaqueza: | --- Fuiste incostante y liviana; | De fuera como manzana | De alegre y bella sazón, | Pero enfermo el corazón | Y la voluntad malsana.»",
              "autor": "Lope",
              "referencia_obra": ", Los amores de Albanio e Ismenia, p. 33."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        }
      ]
