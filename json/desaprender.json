              "ejemplos_citas": [
                {
                  "marca": "",
                  "texto_cita": "«Pero tal cosa no la harás tú, hijo mío, que te criastes [sic] por buenos padres en buenos principios, á menos que en la guerra del moro no hayas desaprendido á ser cristiano --- ¡Desaprender á ser cristiano yo!»",
                  "autor": "Fern.",
                  "referencia_obra": "Caball. Promesa de un soldado á la Virgen del Carmen."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        },
        {
          "id_marcador_html": "— γ )",
