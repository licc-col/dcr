{
  "lema": "CONVENIENTEMENTE.",
  "categoria_gramatical": "adv",
  "introduccion": "-->adv</i>. </font></p>   <font   face=\"arial\">    <p ALIGN=\"JUSTIFY\">De una manera conveniente.",
  "acepciones": [
