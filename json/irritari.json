              "definicion": "Refl.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Menos airados verás, | Que se irritan mucho más | Mis oídos que mis ojos.»",
                  "autor": "Rojas",
                  "referencia_obra": ", Entre bobos anda el juego (Cl. Ebro, 63. 101)."
                },
                {
                  "marca": "X",
                  "texto_cita": "«Tosió hasta irritarse la garganta y toser de verdad.»",
                  "autor": "Carpentier",
                  "referencia_obra": ", Los pasos perdidos, p. 84."
                },
                {
                  "marca": "X",
                  "texto_cita": "«Como la ameba de la imagen, se irrita y reacciona al estímulo exterior aunque pase largas temporadas inerte.»",
                  "autor": "Calderón",
                  "referencia_obra": ", Ancha es Castilla, p. 304."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        },
        {
          "id_marcador_html": "— γ )",
          "id_limpio": "— γ )",
          "definicion": "Part",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "X",
              "texto_cita": "«Sus vivos ojos eran cubiertos alguna vez por sus párpados irritados; lloraba, pero lloraba en secreto como las personas que verdaderamente sufren.»",
              "autor": "Mármol",
              "referencia_obra": ", Amalia, 4 (p. 413)."
            },
            {
              "marca": "X",
              "texto_cita": "«El cerebro me dolía fuertemente; los ojos irritados hacían daño al cerrarse y ardían de estar abiertos.»",
              "autor": "Vasconcelos",
              "referencia_obra": ", El proconsulado, p. 401."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
