      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "X",
              "texto_cita": "«Cuando él la zurra, por algo lo hace.»",
              "autor": "Pagés",
              "referencia_obra": ", Dicc.)."
            },
            {
              "marca": "X",
              "texto_cita": "«Sus maridos las zurran cuando ellas protestan del tiempo que pierden riendo nuestras gracias.»",
              "autor": "Gran encicl. Larousse",
              "referencia_obra": ")."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
              "id_marcador_html": "— α α )",
              "id_limpio": "— α α )",
              "definicion": "Con dat.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«Y una de dos, Señor, u | Le cascan u no le cascan; | Si te le zurran, te vengan | Dél, mas si él se da tal maña | Que sacude, te venga él.»",
                  "autor": "Rojas",
                  "referencia_obra": ", Abre el ojo, 3 (R. 54. 1402)."
                },
                {
                  "marca": "X",
                  "texto_cita": "«Los vellerices nos satisfarán, si les sonsacamos. O nos zurrarán el drupo.»",
                  "autor": "Valle-Inclán",
                  "referencia_obra": ", Viva mi dueño, 5. 28 (p. 207)."
                },
                {
                  "marca": "X",
                  "texto_cita": "«Y le hubiera roto el hocico si no hubiera surgido por allí el patrón don Justo, que me dio de patadas a mi para que me calmara. Me zurró una sarta de porrazos que hasta que quedé dormido entre las piedras, con los huesos tronándome de tan zafados que los tenía.»",
                  "autor": "Rulfo",
                  "referencia_obra": ", El llano en llamas, p. 47."
                }
              ],
              "subsubsubacepciones": [
                {
                  "id_limpio": "—",
                  "definicion": "Además con sin.",
                  "marca": "",
                  "ejemplos_citas": [
                    {
                      "marca": "X",
                      "texto_cita": "«Hubo un tiempo en que un mayordomo de grande zurraba sin misericordia la piel a los pages de su señor.»",
                      "autor": "Hartz.",
                      "referencia_obra": "(Pagés, Dicc.)."
                    }
                  ]
                }
              ]
            },
            {
              "id_marcador_html": "— β β )",
              "id_limpio": "— β β )",
              "definicion": "Con en.",
              "marca": "",
              "ejemplos_citas": [
                {
                  "marca": "X",
                  "texto_cita": "«¿Y quién dice que el Lleras no es un putañero, un abusivo, un condenado? ¿El Valle? ¡Ahí está, esperando que algún gallo le zurre en la cabeza!»",
                  "autor": "Arguedas",
                  "referencia_obra": ", Ríos prof. 8 (p. 97)."
                },
                {
                  "marca": "X",
                  "texto_cita": "«Están zurrando a las chicheras en la cárcel —dijo—. Algunas han chillado duro, como alborotando. Dice que las fuetean en el trasero, delante de sus maridos.»",
                  "autor": "Arguedas",
                  "referencia_obra": ", Ríos prof. 9 (p. 113)."
                }
              ],
              "subsubsubacepciones": []
            }
          ]
        },
        {
          "id_marcador_html": "— β )",
          "id_limpio": "— β )",
          "definicion": "Part.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "X",
              "texto_cita": "«Tal cachetina | Siguió después, | Que malferido, | Zurrado bien, | Allí entre el lodo | Me lo dejé.»",
              "autor": "Mor.",
              "referencia_obra": "rom. 9 (R. 2. 6052)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "— γ )",
          "id_limpio": "— γ )",
          "definicion": "Siendo el acus. los golpes, el verbo pasa solo a significar, Dar, propinar. Con dat.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "X",
              "texto_cita": "«Me zurró una sarta de porrazos que hasta me quedé dormido entre las piedras, con los huesos tronándome de tan zafados que los tenía.»",
              "autor": "Rulfo",
              "referencia_obra": ", El llano en llamas, p. 47."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "— δ )",
          "id_limpio": "— δ )",
          "definicion": "Forma la expresión zurrarle la badana: darle golpes o maltratar de palabra a alguien.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "X",
              "texto_cita": "«Por cuya causa mi padre, después de haberme zurrado muy bien la badana, me llevó a casa de un amigo suyo, llamado Bernardo Vadía, que era barbero del Duque de Alburquerque, embajador ordinario de España, con el cual me acomodó por su aprendiz.»",
              "autor": "",
              "referencia_obra": "Esteb. Gonz. 1. 1. (Cl. C. 108. 66)."
            },
            {
              "marca": "X",
              "texto_cita": "«Inútil era que prometiera zurrarle la badana o hacerle salir la joroba por el pecho de un mal golpe. El continuaba observando una conducta impura.»",
              "autor": "Gran encicl. Larousse",
              "referencia_obra": ")."
            }
          ],
