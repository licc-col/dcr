    {
      "id": "d)",
      "definicion": "Opacar, confundir, turbar (trans.).",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "X",
              "texto_cita": "«La pobreza puede anublar a la nobleza, pero no escurecerla del todo.»",
              "autor": "Cerv.",
              "referencia_obra": "Quij. 2. pról. (R. 1. 404)."
            },
            {
              "marca": "X",
              "texto_cita": "«Porque empacha y anubla las virtudes.»",
              "autor": "Fuentes",
              "referencia_obra": ", Philosophia, fol. 114 (Dicc. Autor.)."
            },
            {
              "marca": "X",
              "texto_cita": "«Un presentimiento indefinible nubló el corazón del héroe.»",
              "autor": "Pardo Bazán",
              "referencia_obra": ", (Gran. encicl. Larousse)."
            },
            {
              "marca": "X",
              "texto_cita": "«Sobre la roca yerma y desolada nunca había nublado su humildad el pensamiento que ahora le inquietaba.»",
              "autor": "Rodó",
              "referencia_obra": ", Motivos de Proteo, p. 167."
            },
            {
              "marca": "X",
              "texto_cita": "«Aquellas palabras poco oportunas nublaron por un momento la alegría reinante.»",
              "autor": "Dicc. Planeta",
              "referencia_obra": "."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
