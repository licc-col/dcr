{
  "lema": "EMBOBAR.",
  "categoria_gramatical": "v.",
  "introduccion": "",
  "acepciones": [
    {
      "id": "a)",
      "definicion": "Cautivar de tal modo la atención de alguno, que, de absorto, tenga la apariencia de un bobo (trans.).",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«En comenzando el amor a dar gusto sensible, se dejan tanto llevar dél como tengo dicho, y a mi parecer amaría muy mejor no dejándose embobar, que en este término de oración pueden muy bien resistir.»",
              "autor": "",
              "referencia_obra": "Sta. Ter. Fund. 6 (R. 53. 1901)."
            },
            {
              "marca": "",
              "texto_cita": "«Mas su modestia es lazo | En que te prende a fin de que los oigas [sus versos]; | Los oyes y te deja, y otro incauto | Busca a quien embobar, que nunca falta.»",
              "autor": "Arriaza",
              "referencia_obra": ", Arte poét. 1 (R. 67. 1201)."
            },
            {
              "marca": "",
              "texto_cita": "«Discursos --- tejidos de paralogismos brillantes, que emboban a la muchedumbre y hacen reír al sabio.»",
              "autor": "Capm.",
              "referencia_obra": "Filosof. eloc. introd. (18)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "— β )",
          "id_limpio": "— β )",
          "definicion": "Con con, para expresar el medio que se emplea para cautivar.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Ella embobará a cualquiera | Con su chiste y atractivo.»",
              "autor": "",
              "referencia_obra": "T. Iriarte, El señorito mimado, 2. 9 (4. 234)."
            },
            {
              "marca": "",
              "texto_cita": "«Y como le habéis sabido | Embobar con apariencias | De santica»",
              "autor": "Mor.",
              "referencia_obra": "La mojigata, 1. 7 (R. 2. 3982)."
            },
            {
              "marca": "",
              "texto_cita": "«Y mientras al rudo vulgo | Embobéis y corrompáis | Con farsas ---»",
              "autor": "",
              "referencia_obra": "Id. rom. 6 (R. 2. 6022)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        }
      ]
    },
    {
      "id": "b)",
      "definicion": "Refl. Quedarse suspenso y admirado, como hecho un bobo.",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«En ver estas cosas se quedó abobado el barbero Bertol Araujo; aunque para esto de embobarse no había él menester apetite.»",
              "autor": "",
              "referencia_obra": "Píc. Justina, 2. 3. 1, § 2 (R. 33. 1311)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "— β )",
          "id_limpio": "— β )",
          "definicion": "Con un gerundio, que denota la ocasión con que uno se queda hecho un bobo.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Se emboba pensando en ello.»",
              "autor": "Núñez",
              "referencia_obra": "de Arce, Quien debe paga, 1. 11 (135)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "— γ )",
          "id_limpio": "— γ )",
          "definicion": "Con con.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Supuesto | Que somos dos, no se emboben | Las cuatro con don Mamerto, | Y dejen a un hombre solo.»",
              "autor": "R. de la Cruz",
              "referencia_obra": ", El café extranjero (2. 539)."
            },
            {
              "marca": "",
              "texto_cita": "«Por afición me embobo | Con amoríos ajenos.»",
              "autor": "Bretón",
              "referencia_obra": ", La redacción de un perlódico, 2. 1 (2. 87)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "— δ )",
          "id_limpio": "— δ )",
          "definicion": "Con en, que expresa el objeto en que está como fija la atención.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«En su vista | Se me emboba toda el alma, | Que aunque socarrón, hechiza.»",
              "autor": "Tirso",
              "referencia_obra": ", Mari-Hernández, 3. 7 (R. 5. 1223)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "— ε )",
          "id_limpio": "— ε )",
          "definicion": "Con de, en el sentido de origen, causa.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Embobarse de algo.»",
              "autor": "Acad.",
              "referencia_obra": "Gram. Salvá, Gram."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        }
      ]
    },
    {
      "id": "c)",
      "definicion": "Part. Correspondiente así al verbo activo como al reflejo.",
      "marca": "",
      "ejemplos_citas": [],
      "subsubsubacepciones": [],
      "subacepciones": [
        {
          "id_marcador_html": "— α )",
          "id_limpio": "— α )",
          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Los días que duraba esto, andaba como embobada, no quisiera ver, ni hablar, sino abrazarme con mi pena, que para mí era mayor gloria, que cuantas hay en todo lo criado.»",
              "autor": "Sta. Ter.",
              "referencia_obra": "Vida, 29 (R. 53. 901)."
            },
            {
              "marca": "",
              "texto_cita": "«Cada vez que me habla, me tiene como embobada.»",
              "autor": "",
              "referencia_obra": "Ead. ib. 34 (R. 53. 1051)."
            },
            {
              "marca": "",
              "texto_cita": "«¿De dónde han de pagar ahora censo? A mí me tiene este negocio embobada.»",
              "autor": "",
              "referencia_obra": "Ead. Cartas, 2. 43 (R. 55. 3371)."
            },
            {
              "marca": "",
              "texto_cita": "«Sin respondelle palabra, embobados y suspensos le estuvieron escuchando.»",
              "autor": "Cerv.",
              "referencia_obra": "Quij. 1. 11 (R. 1. 2752)."
            },
            {
              "marca": "",
              "texto_cita": "«Y yo ni más ni menos, dijo la ventera, porque nunca tengo buen rato en mi casa sino aquel que vos estáis escuchando leer, que estáis tan embobado, que no os acordáis de reñir por entonces.»",
              "autor": "",
              "referencia_obra": "Id. ib. 1. 32 (R. 1. 3391)."
            },
            {
              "marca": "",
              "texto_cita": "«Robó, como se ha dicho, a la linda Magalona, llevándola a las ancas por el aire, dejando embobados a cuantos desde la tierra los miraban.»",
              "autor": "",
              "referencia_obra": "Id. ib. 2. 40 (R. 1. 4871)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "— β )",
          "id_limpio": "— β )",
          "definicion": "Con un gerundio.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Entretenidos tuvo esta gente a todos. Estábase Plutón embobado oyéndolos.»",
              "autor": "",
              "referencia_obra": "Quev. Entrem. (R. 23. 3642)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "— γ )",
          "id_limpio": "— γ )",
          "definicion": "Con en.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«¡En bellezas asturianas | Embobado, de tu vida | Pródigo pretendes ser!»",
              "autor": "Tirso",
              "referencia_obra": ", Amar por arte mayor, 1. 4 (R. 5. 4251)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        },
        {
          "id_marcador_html": "— δ )",
          "id_limpio": "— δ )",
          "definicion": "Con de.",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Embobada | Me he quedado de saber, | Que los que a una mujer aman, | Riñen por otra.»",
              "autor": "Cald.",
              "referencia_obra": "¿Cuál es mayor perfección? 2. 14 (R. 7. 803)."
            },
            {
              "marca": "",
              "texto_cita": "«A todo estaba presente Sancho embobado y atónito de ver la honra que a su señor aquellos príncipes le hacían.»",
              "autor": "Cerv.",
              "referencia_obra": "Quij. 2. 31 (R. 1. 4701)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": []
        }
      ]
    }
