          "subsubacepciones": [
            {
              "id_marcador_html": "</p>   <p ALIGN=\"JUSTIFY\">—</font><font face=\"symbol\"> α</font><font face=\"arial\"> </font><font face=\"symbol\">α</font><font face=\"arial\"> )",
              "id_limpio": "— α α )",
              "definicion": "Forma la expresión <i>a lo rasgado</i>.</font><font   face=\"arial\" color=\"#000080\"> X",
              "ejemplos_citas": [
                {
                  "texto_cita": "«Añadiéndosele a estas arrogancias ser un poco músico,   y tocar una guitarra a lo rasgado, de manera que decían algunos que la hacía hablar.»",
                  "autor": "<a name=\"autor3\"><font color = \"#FF000\"><u>Cerv.</u></font></b>",
                  "author": "<a name=\"autor3\"><font color = \"#FF000\"><u>Cerv.</u></font></b>",
                  "referencia_obra": "<i>Quij</i>. 51 (R. 1. 397<sup>1</sup>)."
                }
              ]
            },
            {
              "id_marcador_html": "</p>   <p ALIGN=\"JUSTIFY\">— </font><font face=\"symbol\">β</font><font face=\"arial\"> </font><font face=\"symbol\">β</font><font face=\"arial\"> )",
              "id_limpio": "— β β )",
              "definicion": "Se usa también la forma <i>rasguear</i>.</font><font   face=\"arial\" color=\"#000080\"> X",
              "ejemplos_citas": [
                {
                  "texto_cita": "«El inglesito comenzó a rasguear en la guitarra de modo   que dejaba algo mejor parado su pabellón que lo dejara anteriormente.»",
                  "autor": "<a name=\"autor4\"><font color = \"#FF000\"><u>A. Reyes</u></font></b>",
                  "author": "<a name=\"autor4\"><font color = \"#FF000\"><u>A. Reyes</u></font></b>",
                  "referencia_obra": "(<dicautor><a name=\"autor5\"><font color = \"#FF000\"><u>Pagés</u></font></b></dicautor>, <i>Dicc</i>.).</font><font face=\"arial\" color=\"#000080\"> X"
                },
                {
                  "texto_cita": "«El barbero los siguió </font><font face=\"symbol\">|</font><font   face=\"arial\" color=\"#000080\"> Rasgueando una guitarra, </font><font face=\"symbol\">|</font><font face=\"arial\" color=\"#000080\"> Diciendo lo necio a veces </font><font face=\"symbol\">|</font><font face=\"arial\" color=\"#000080\"> La cuerda con   quien más le ata.»",
                  "autor": "<a name=\"autor6\"><font color = \"#FF000\"><u>León</u></font></b>",
                  "author": "<a name=\"autor6\"><font color = \"#FF000\"><u>León</u></font></b>",
                  "referencia_obra": ", <i>Poet</i>. 2. pl.<i> </i>90 (<i>Dicc.   Autor</i>)."
                }
              ]
            }
          ]
