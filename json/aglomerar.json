          "subsubacepciones": [
            {
              "id_marcador_html": "</font></p>   <p ALIGN=\"JUSTIFY\"> <font face=\"arial\">—</font><font face=\"arial\" color=\"#000080\">      </font><font face=\"symbol\">α</font><font face=\"arial\" color=\"#000080\"> </font><font face=\"symbol\">α</font><font   face=\"arial\" color=\"#000080\"> </font><font face=\"arial\">)",
              "id_limpio": "— α α )",
              "definicion": "<i>Refl.</i> </font><font   face=\"arial\" color=\"#000080\">",
              "ejemplos_citas": [
                {
                  "texto_cita": "«Cuando queremos explicar la rapidez con que pasan      los objetos ó se aglomeran los sucesos, la pluma del escritor, arrebatada      por las ideas, deja olvidadas las partículas.»",
                  "autor": "<a name=\"autor1554\"><font color = \"#FF000\"><u>Lista</u></font></b>",
                  "author": "<a name=\"autor1554\"><font color = \"#FF000\"><u>Lista</u></font></b>",
