          "definicion": "",
          "marca": "",
          "ejemplos_citas": [
            {
              "marca": "",
              "texto_cita": "«Otro su estilo tanto pule y lima, | Que le quita el vigor, le desanima.»",
              "autor": "T. Iriarte",
              "referencia_obra": ", Arte poétic. de Hor. (4. 5)."
            }
          ],
          "subsubsubacepciones": [],
          "subsubacepciones": [
            {
