          "definicion": "<font   face=\"arial\" color=\"#000080\"></font>",
          "ejemplos_citas": [
            {
              "texto_cita": "«A quien pensó lo peor no le hallan desprevenido los casos,   ni le sobreviene impensadamente la confusión de sus intentos frustrados.»",
              "autor": "<a name=\"autor1845\"><font color = \"#FF000\"><u>Saav.</u></font></b>",
              "author": "<a name=\"autor1845\"><font color = \"#FF000\"><u>Saav.</u></font></b>",
              "referencia_obra": "<i>Emp. </i>29 (R. 25. 77<sup>2</sup>). </font><font face=\"arial\"   color=\"#000080\">"
            },
            {
              "texto_cita": "«No sea que cuando vinieren los de Macedonia conmigo y os hallen   desprevenidos, tengamos que avergonzarnos nosotros.»",
              "autor": "<a name=\"autor1846\"><font color = \"#FF000\"><u>Scío</u></font></b>",
